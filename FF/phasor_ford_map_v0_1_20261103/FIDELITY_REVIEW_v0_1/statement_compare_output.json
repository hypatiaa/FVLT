      "stmt": "private theorem bounded_bezout (a b B : ℕ) (hb : 0 < b) (hbB : b ≤ B) (hcop : Nat.Coprime a b) : ∃ c d : ℤ, 0 < d ∧ d ≤ (B : ℤ) ∧ (B : ℤ) < (b : ℤ) + d ∧ (b : ℤ) * c - (a : ℤ) * d = 1"
