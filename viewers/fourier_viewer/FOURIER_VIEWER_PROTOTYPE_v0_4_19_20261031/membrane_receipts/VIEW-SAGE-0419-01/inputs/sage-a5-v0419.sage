# v0.4.19 (SCHEMA_ADDENDUM_26, item 5): is the group generated by the dodecahedron preset's own two moves isomorphic to A5?
# Input: the JSON written by build/dump-a5-moves-v0419.cjs (the build's own permutations of its 60 flags, 0-based images).
# Checks: order 60; is_isomorphic(AlternatingGroup(5)); an explicit isomorphism (isomorphism_to); the element-order profile; both moves of order 5;
# the action on the 60 flags is regular (transitive, order = degree). Exact (permutation groups). Exit code 1 on any FAIL.
import json, sys
d = json.load(open(sys.argv[1]))
n = d['flags']
def perm(img):
    return [i + 1 for i in img]
S = SymmetricGroup(n)
L = S(perm(d['left'])); R = S(perm(d['right']))
G = S.subgroup([L, R])
A5 = AlternatingGroup(5)
res = []
def ok(name, c):
    res.append(bool(c)); print(('PASS ' if c else 'FAIL ') + name)
ok('the dump is the build\'s: %d flags, %d vertices, core sha256 %s' % (n, d['vertices'], d['core_sha256']), n == 60 and d['vertices'] == 20)
ok('order of <left, right> = %d (expected 60)' % G.order(), G.order() == 60)
iso = G.is_isomorphic(A5)
ok('is_isomorphic(AlternatingGroup(5)) = %s' % iso, iso)
phi = G.isomorphism_to(A5)
ok('an explicit isomorphism to A5 exists (isomorphism_to): left -> %s, right -> %s' % (phi(L), phi(R)), phi is not None)
prof = {}
for g in G:
    o = g.order(); prof[o] = prof.get(o, 0) + 1
ok('element orders %s (A5: {1: 1, 2: 15, 3: 20, 5: 24})' % dict(sorted(prof.items())), prof == {1: 1, 2: 15, 3: 20, 5: 24})
ok('each move has order 5 (left %d, right %d)' % (L.order(), R.order()), L.order() == 5 and R.order() == 5)
ok('the action on the 60 flags is regular (transitive and order = degree)', G.is_transitive() and G.order() == n)
ok('G is simple (A5 is the smallest non-abelian simple group)', G.is_simple())
print('SUMMARY sage-a5-v0419: %d passed, %d failed' % (sum(res), len(res) - sum(res)))
sys.exit(0 if all(res) else 1)
