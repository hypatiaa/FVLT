      approx.selectedPrimitiveReal=cf*approx.primitiveReal;approx.selectedRealTotal=cf*approx.realTotal;
      approx.neronRealTotal=normalization.factorOfModelDifferential ? number(rat(BigInt(normalization.factorOfModelDifferential.num),BigInt(normalization.factorOfModelDifferential.den)))*approx.realTotal : null;
    }
    const key=str(j);
