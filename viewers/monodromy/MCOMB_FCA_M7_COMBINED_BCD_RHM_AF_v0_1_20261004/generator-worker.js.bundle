/* Synchronous SHA-256 for untrusted browser packet preparation only.
   Server authorization uses Node crypto and the frozen T4 public gate. */
function sha256(input){
 const bytes=typeof input==='string'?new TextEncoder().encode(input):input;
 const K=[0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2];
 const h=[0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19],length=Math.ceil((bytes.length+9)/64)*64,data=new Uint8Array(length);data.set(bytes);data[bytes.length]=128;const dv=new DataView(data.buffer);dv.setBigUint64(length-8,BigInt(bytes.length)*8n);const ro=(x,n)=>(x>>>n)|(x<<(32-n));
 for(let off=0;off<length;off+=64){const w=new Uint32Array(64);for(let i=0;i<16;i++)w[i]=dv.getUint32(off+4*i);for(let i=16;i<64;i++){const a=w[i-15],b=w[i-2];w[i]=(ro(a,7)^ro(a,18)^(a>>>3))+w[i-16]+(ro(b,17)^ro(b,19)^(b>>>10))+w[i-7];}let [a,b,c,d,e,f,g,j]=h;for(let i=0;i<64;i++){const t=(j+(ro(e,6)^ro(e,11)^ro(e,25))+((e&f)^(~e&g))+K[i]+w[i])|0,u=((ro(a,2)^ro(a,13)^ro(a,22))+((a&b)^(a&c)^(b&c)))|0;[a,b,c,d,e,f,g,j]=[(t+u)|0,a,b,c,(d+t)|0,e,f,g];}for(const [i,x]of [a,b,c,d,e,f,g,j].entries())h[i]=(h[i]+x)|0;}
 return h.map(x=>(x>>>0).toString(16).padStart(8,'0')).join('');
}
if(typeof module==='object')module.exports=sha256;

/* Duplicate-key rejection before JSON.parse, including exact strings. */
function strictJSON(text,max=32000000){
 if(typeof text!=='string'||new TextEncoder().encode(text).length>max)throw Error('JSON byte cap');let i=0,nodes=0;
 const ws=()=>{while(/[\t\n\r ]/.test(text[i]||'!'))i++;};
 function string(){const start=i++;while(i<text.length){if(text[i]==='\\'){i+=2;continue;}if(text[i++]==='"')return JSON.parse(text.slice(start,i));}throw Error('Unterminated string');}
 function value(depth){ws();if(depth>80||++nodes>2000000)throw Error('JSON work cap');if(text[i]==='"'){string();return;}if(text[i]==='{'){i++;ws();const seen=new Set();if(text[i]==='}'){i++;return;}while(true){ws();if(text[i]!=='"')throw Error('Object key required');const k=string();if(seen.has(k))throw Error('Duplicate JSON key: '+k);seen.add(k);ws();if(text[i++]!==':')throw Error('Expected colon');value(depth+1);ws();const c=text[i++];if(c==='}')return;if(c!==',')throw Error('Expected object separator');}}if(text[i]==='['){i++;ws();if(text[i]===']'){i++;return;}while(true){value(depth+1);ws();const c=text[i++];if(c===']')return;if(c!==',')throw Error('Expected array separator');}}const m=/^(?:true|false|null|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/.exec(text.slice(i));if(!m)throw Error('Invalid JSON value');i+=m[0].length;}
 value(0);ws();if(i!==text.length)throw Error('Trailing JSON');return JSON.parse(text);
}
if(typeof module==='object')module.exports=strictJSON;

const SOURCE={"/BSD_MINIMAL_TATE_SCHEMA_v0_3_20260907/model-replay.cjs":"'use strict';\r\n// Exact transport, reduction consistency and scoped good-prime certification. No full Tate engine.\r\nconst crypto = require('node:crypto');\r\nconst fail = message => { throw new Error(message); };\r\nconst gcd = (a,b) => { a=a<0n?-a:a; b=b<0n?-b:b; while(b)[a,b]=[b,a%b]; return a; };\r\nfunction rat(n,d=1n) { if(!d)fail('Zero denominator'); if(n.toString(2).length>16384||d.toString(2).length>16384)fail('Exact intermediate work cap'); if(d<0n){n=-n;d=-d;} const g=gcd(n,d); return [n/g,d/g]; }\r\nfunction R(s) { if(typeof s!=='string'||s.length>194||! /^(0|-?[1-9][0-9]*)(\\/[1-9][0-9]*)?$/.test(s))fail('Invalid rational string'); const [n,d='1']=s.split('/'); if(n.replace('-','').length>96||d.length>96)fail('Rational size cap'); const q=rat(BigInt(n),BigInt(d)); if(S(q)!==s)fail('Noncanonical rational'); return q; }\r\nconst S=q=>q[1]===1n?String(q[0]):q.join('/');\r\nconst add=(a,b)=>rat(a[0]*b[1]+b[0]*a[1],a[1]*b[1]);\r\nconst neg=a=>[-a[0],a[1]], sub=(a,b)=>add(a,neg(b));\r\nconst mul=(a,b)=>rat(a[0]*b[0],a[1]*b[1]);\r\nconst div=(a,b)=>rat(a[0]*b[1],a[1]*b[0]);\r\nconst pow=(a,k)=>rat(a[0]**BigInt(k),a[1]**BigInt(k));\r\nconst times=(a,n)=>mul(a,[BigInt(n),1n]);\r\nconst sum=(...xs)=>xs.reduce(add,[0n,1n]);\r\nfunction canonical(x){ if(Array.isArray(x))return '['+x.map(canonical).join(',')+']'; if(x&&typeof x==='object')return '{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+canonical(x[k])).join(',')+'}'; return JSON.stringify(x); }\r\nconst hash=x=>crypto.createHash('sha256').update(typeof x==='string'?x:canonical(x)).digest('hex');\r\nfunction shape(x,keys){if(!x||Array.isArray(x)||typeof x!=='object'||Object.keys(x).sort().join('|')!==keys.slice().sort().join('|'))fail('Unexpected fields');}\r\nfunction invariants(a){\r\n if(!Array.isArray(a)||a.length!==5)fail('Five coefficients required');\r\n const [a1,a2,a3,a4,a6]=a.map(R), b2=sum(pow(a1,2),times(a2,4)),b4=sum(times(a4,2),mul(a1,a3)),b6=sum(pow(a3,2),times(a6,4));\r\n const b8=sum(mul(pow(a1,2),a6),times(mul(a2,a6),4),neg(mul(mul(a1,a3),a4)),mul(a2,pow(a3,2)),neg(pow(a4,2)));\r\n const c4=sub(pow(b2,2),times(b4,24)),c6=sum(neg(pow(b2,3)),times(mul(b2,b4),36),times(b6,-216));\r\n const discriminant=sum(neg(mul(pow(b2,2),b8)),times(pow(b4,3),-8),times(pow(b6,2),-27),times(mul(mul(b2,b4),b6),9));\r\n if(!discriminant[0])fail('Singular model');\r\n return Object.fromEntries(Object.entries({b2,b4,b6,b8,c4,c6,discriminant,j:div(pow(c4,3),discriminant)}).map(([k,v])=>[k,S(v)]));\r\n}\r\nfunction model(a){const body={field:'Q',ainvs:a,invariants:invariants(a)}; return {modelId:hash(body),...body};}\r\nfunction transform(a,w){\r\n shape(w,['u','r','s','t']); const [u,r,s,t]=['u','r','s','t'].map(k=>R(w[k])); if(!u[0])fail('u must be nonzero');\r\n const [a1,a2,a3,a4,a6]=a.map(R);\r\n return [div(sum(a1,times(s,2)),u),div(sum(a2,neg(mul(a1,s)),times(r,3),neg(pow(s,2))),pow(u,2)),div(sum(a3,mul(a1,r),times(t,2)),pow(u,3)),div(sum(a4,times(mul(a2,r),2),neg(mul(a1,sum(mul(r,s),t))),neg(mul(a3,s)),times(pow(r,2),3),times(mul(s,t),-2)),pow(u,4)),div(sum(a6,neg(mul(mul(a1,r),t)),mul(a2,pow(r,2)),neg(mul(a3,t)),mul(a4,r),pow(r,3),neg(pow(t,2))),pow(u,6))].map(S);\r\n}\r\nfunction inverse(w){const [u,r,s,t]=['u','r','s','t'].map(k=>R(w[k]));return {u:S(div(R('1'),u)),r:S(neg(div(r,pow(u,2)))),s:S(neg(div(s,u))),t:S(div(sub(mul(r,s),t),pow(u,3)))};}\r\n// Composition is first w: E0 -> E1, then v: E1 -> E2.\r\nfunction compose(w,v){const [u,r,s,t]=['u','r','s','t'].map(k=>R(w[k])),[U,V,W,T]=['u','r','s','t'].map(k=>R(v[k]));return {u:S(mul(u,U)),r:S(sum(r,mul(pow(u,2),V))),s:S(sum(s,mul(u,W))),t:S(sum(t,mul(mul(s,pow(u,2)),V),mul(pow(u,3),T)))};}\r\nfunction pointOn(a,p){if(p?.infinity===true){shape(p,['infinity']);return true;}shape(p,['x','y']);const [a1,a2,a3,a4,a6]=a.map(R),x=R(p.x),y=R(p.y);return !sub(sum(pow(y,2),mul(mul(a1,x),y),mul(a3,y)),sum(pow(x,3),mul(a2,pow(x,2)),mul(a4,x),a6))[0];}\r\nfunction pointMap(a,w,p){if(!pointOn(a,p))fail('Off-curve point');if(p.infinity)return {infinity:true};const [u,r,s,t]=['u','r','s','t'].map(k=>R(w[k])),dx=sub(R(p.x),r);const q={x:S(div(dx,pow(u,2))),y:S(div(sum(R(p.y),neg(mul(s,dx)),neg(t)),pow(u,3)))};if(!pointOn(transform(a,w),q))fail('Point transport failed');return q;}\r\nfunction phaseMap(v,m){const [a,b,c,d]=m.flat().map(x=>{const q=R(x);if(q[1]!==1n)fail('Integral marking required');return q;});if(S(sub(mul(a,d),mul(b,c)))!=='1')fail('Marking must have determinant +1');const [x,y]=v.map(R);return [sub(mul(d,x),mul(c,y)),sub(mul(a,y),mul(b,x))].map(S);}\r\nfunction verifyTransport(packet){\r\n if(Buffer.byteLength(JSON.stringify(packet),'utf8')>4000000)fail('Packet byte cap');\r\n function depth(x,n=0){if(n>24)fail('Nesting cap');if(x&&typeof x==='object')Object.values(x).forEach(v=>depth(v,n+1));}depth(packet);\r\n const sources=new Map();for(const src of packet.sources){if(sources.has(src.sha256)||hash(src.bytes)!==src.sha256)fail('Source bytes mismatch or duplicate');sources.set(src.sha256,src);}\r\n const sourceJSON=id=>{if(!sources.has(id))fail('Missing source artifact');return JSON.parse(sources.get(id).bytes);};\r\n function evidence(e){if(!sources.has(e.sourceHash))fail('Missing evidence source');if(e.method.startsWith('LOCAL_'))fail('Local evidence verifier not implemented');if(e.status==='CONDITIONAL'?!e.assumptions.length:!!e.assumptions.length)fail('Conditional assumptions mismatch');if(['CERTIFIED','RIGOROUS_BOUND'].includes(e.status)&&!e.certificate)fail('Missing certificate reference');const ordered=[...sources.keys()],at=ordered.indexOf(e.sourceHash);for(const id of e.dependencies)if(ordered.indexOf(id)<0||ordered.indexOf(id)>=at)fail('Missing, forward or self dependency');}\r\n const models=new Map();for(const m of packet.models){if(models.has(m.modelId)||canonical(model(m.ainvs))!==canonical(m))fail('Model identity or invariants mismatch');models.set(m.modelId,m);}\r\n if(!models.has(packet.anchor.inputModelId))fail('Missing anchor model');\r\n if(packet.anchor.legacyContextId!==null)fail('Legacy adapter requires independent packet replay; not implemented here');\r\n if(canonical(sourceJSON(packet.anchor.sourceHash))!==canonical({field:'Q',ainvs:models.get(packet.anchor.inputModelId).ainvs,selectedMultiplier:packet.normalization.sourceSelectedMultiplier}))fail('Anchor source mismatch');\r\n let twistLast=null;for(const edge of packet.twistLineage){if(!models.has(edge.baseModelId)||!models.has(edge.twistedModelId)||(twistLast&&edge.baseModelId!==twistLast))fail('Disconnected twist lineage');const a=models.get(edge.baseModelId).ainvs;if(a.slice(0,3).some(x=>x!=='0')||!R(edge.parameter)[0])fail('Unsupported or zero twist');const d=R(edge.parameter);let wanted;if(edge.kind==='QUADRATIC_SHORT')wanted=['0','0','0',S(mul(R(a[3]),pow(d,2))),S(mul(R(a[4]),pow(d,3)))];else if(edge.kind==='QUARTIC_B_ZERO'&&a[4]==='0')wanted=['0','0','0',S(mul(R(a[3]),d)),'0'];else fail('Unsupported twist');if(canonical(wanted)!==canonical(models.get(edge.twistedModelId).ainvs))fail('Twist coefficients mismatch');const body={...edge};delete body.sourceHash;if(canonical(sourceJSON(edge.sourceHash))!==canonical(body))fail('Twist source mismatch');twistLast=edge.twistedModelId;}\r\n if(twistLast&&twistLast!==packet.anchor.inputModelId)fail('Twist does not anchor this curve');\r\n let last=packet.anchor.inputModelId,c=packet.normalization.sourceSelectedMultiplier,U=R('1');R(c);if(!R(c)[0])fail('Zero differential');\r\n const reachable=new Set([last]);\r\n for(const step of packet.transformations){if(step.fromModelId!==last||!models.has(step.toModelId))fail('Disconnected model chain');const from=models.get(last),to=models.get(step.toModelId),want=transform(from.ainvs,step.urst);if(canonical(want)!==canonical(to.ainvs))fail('Transformation coefficients do not replay');if(step.direction!=='SOURCE_TO_TARGET'||step.pullbackModelDifferentialFactor!==step.urst.u)fail('Differential direction mismatch');c=S(div(R(c),R(step.urst.u)));if(step.targetSelectedMultiplier!==c)fail('Selected differential not preserved');U=mul(U,R(step.urst.u));last=step.toModelId;reachable.add(last);}\r\n const norm=packet.normalization;if(norm.targetModelId!==last||norm.targetSelectedMultiplier!==c||norm.composedPullbackFactor!==S(U))fail('Normalization chain mismatch');\r\n if(norm.modelDifferential!=='dx/(2*y+a1*x+a3)')fail('Wrong differential');\r\n const binding={anchor:packet.anchor,modelId:last,normalization:packet.normalization,transformations:packet.transformations,twistLineage:packet.twistLineage};\r\n if(packet.contextId!==hash(binding))fail('Context hash mismatch');\r\n const m=packet.marking.basisMatrix;phaseMap(['0','0'],m);\r\n if(packet.marking.mcombSourceHash!==null)fail('Mcomb source adapter requires inherited transport replay; not implemented here');\r\n for(const p of packet.points){if(!reachable.has(p.modelId)||!pointOn(models.get(p.modelId).ainvs,p.coordinates))fail('Point membership failed');if(canonical(sourceJSON(p.sourceHash))!==canonical({modelId:p.modelId,coordinates:p.coordinates}))fail('Point source mismatch');}\r\n const panels=new Set();for(const panel of packet.panelBindings){if(panels.has(panel.panel)||panel.contextId!==packet.contextId||panel.normalizationId!==hash(norm)||panel.markingId!==hash(packet.marking)||!reachable.has(panel.modelId))fail('Stale or duplicate panel binding');panels.add(panel.panel);}\r\n if(panels.size!==6)fail('Every linked panel must be bound');\r\n function prime(s){const n=Number(s);if(!Number.isSafeInteger(n)||n<2||n>1009)fail('Prime verification work cap');for(let d=2;d*d<=n;d++)if(n%d===0)fail('Composite prime field');return n;}\r\n const valuation=(s,p)=>{let [n,d]=R(s),v=0;const P=BigInt(p);if(!n)fail('Zero valuation input');while(n%P===0n){n/=P;v++;}while(d%P===0n){d/=P;v--;}return v;};\r\n if(packet.minimalModel){const q=packet.minimalModel;if(!reachable.has(q.modelId))fail('Unlinked minimal model');evidence(q.evidence);const a=models.get(q.modelId).ainvs;if(q.scope==='GLOBAL_Q'){if(q.prime!==null||a.some(s=>R(s)[1]!==1n))fail('Global minimal claim requires an integral model');}else{const p=prime(q.prime);if(a.some(s=>R(s)[1]%BigInt(p)===0n))fail('Local model is not p-integral');}}\r\n if(norm.neron){evidence(norm.neron.evidence);if(!packet.minimalModel||packet.minimalModel.scope!=='GLOBAL_Q'||norm.neron.modelId!==packet.minimalModel.modelId||norm.neron.modelId!==last)fail('Neron reference requires the stated global minimal target');}\r\n const local=new Map(),localAssessments=[];\r\n const modulo=(value,p)=>{\r\n  const P=BigInt(p),[n,d]=R(value),a=(n%P+P)%P,b=d%P;\r\n  if(!b)fail('Nonintegral invariant modulo p');\r\n  for(let k=1n;k<P;k++)if(b*k%P===1n)return Number(a*k%P);\r\n  fail('No modular inverse');\r\n };\r\n const square=(a,p)=>{for(let y=1;y<p;y++)if(y*y%p===a)return true;return false;};\r\n const checkAdditiveTamagawa=(kodaira,cp)=>{\r\n  const allowed={II:[1n],'II*':[1n],III:[2n],'III*':[2n],IV:[1n,3n],'IV*':[1n,3n],'I0*':[1n,2n,4n]};\r\n  const values=allowed[kodaira]||(/^I[1-9][0-9]*[*]$/.test(kodaira)?[2n,4n]:null);\r\n  if(!values||!values.includes(cp))fail('Tamagawa number incompatible with Kodaira type');\r\n };\r\n const verifier={name:'BSD_LOCAL_REDUCTION_REFERENCE',version:'0.3.0',sha256:hash(require('node:fs').readFileSync(__filename,'utf8'))};\n for(const q of packet.localData){\r\n  const p=prime(q.p);\r\n  if(local.has(q.p)||!reachable.has(q.modelId))fail('Duplicate local prime or unlinked model');\r\n  local.set(q.p,q);evidence(q.evidence);if(q.minimalityEvidence)evidence(q.minimalityEvidence);\r\n  const binding={contextId:packet.contextId,modelId:q.modelId,normalizationId:hash(norm),p:q.p};\r\n  const inputRecordHash=hash(q);\r\n  if(!q.result){localAssessments.push({...binding,assessment:'UNAVAILABLE',producerStatus:q.evidence.status,inputRecordHash});continue;}\r\n  const modelQ=models.get(q.modelId);\r\n  if(modelQ.ainvs.some(s=>R(s)[1]%BigInt(p)===0n))fail('Local model is not p-integral');\r\n  const r=q.result,n=Number(r.discriminantValuation),f=Number(r.conductorExponent),w=Number(r.wildConductorContribution),cp=BigInt(r.tamagawaNumber);\r\n  if(![n,f,w].every(x=>Number.isSafeInteger(x)&&x>=0&&x<=16384))fail('Local exponent work cap');\r\n  if(valuation(modelQ.invariants.discriminant,p)!==n||w>f||p>3&&w!==0)fail('Local valuation or wild conductor mismatch');\n  const conductorBound=p===2?8:p===3?5:2;\n  if(f>conductorBound)fail('Conductor exponent exceeds the bound over Q at p='+p);\n  if(r.reduction==='GOOD'){\r\n   if(n!==0||f!==0||w!==0||cp!==1n||r.kodaira!=='I0'||r.split!==null)fail('Good reduction consistency');\r\n   const a=modelQ.ainvs.map(s=>modulo(s,p));let count=1;\r\n   for(let x=0;x<p;x++)for(let y=0;y<p;y++)if(((y*y+a[0]*x*y+a[2]*y-x*x*x-a[1]*x*x-a[3]*x-a[4])%p+p)%p===0)count++;\r\n   const polynomial=['1',String(count-p-1),String(p)];\r\n   if(canonical(r.eulerPolynomial)!==canonical(polynomial))fail('Good prime polynomial count mismatch');\r\n   const certificate={...binding,schema:'BSD_GOOD_PRIME_CERTIFICATE_V1',verifier,\r\n    method:'P_INTEGRAL_UNIT_DISCRIMINANT_AND_EXHAUSTIVE_FP_COUNT',\r\n    ainvs:modelQ.ainvs,discriminant:modelQ.invariants.discriminant,reducedAinvs:a.map(String),\r\n    discriminantResidue:String(modulo(modelQ.invariants.discriminant,p)),\r\n    pointsIncludingInfinity:String(count),ap:String(p+1-count),eulerPolynomial:polynomial,\r\n    localMinimality:'PROVED_AT_THIS_PRIME_BY_UNIT_DISCRIMINANT',kodaira:'I0',\r\n    conductorExponent:'0',tamagawaNumber:'1',assumptions:[],dependencies:[],\r\n    scope:'THIS_MODEL_AND_THIS_PRIME_ONLY'};\r\n   localAssessments.push({...binding,producerStatus:q.evidence.status,inputRecordHash,\r\n    assessment:'LOCAL_EXACT_GOOD_REDUCTION',status:'CERTIFIED',certificateId:hash(certificate),certificate});\r\n  }else{\r\n   if(!q.minimalityEvidence)fail('Bad-prime result lacks minimality evidence');\r\n   if(n<1)fail('Bad reduction requires positive discriminant valuation');\r\n   const checkedRules=['Q_CONDUCTOR_EXPONENT_BOUND','CONDUCTOR_DISCRIMINANT_INEQUALITY'];\n   if(p>=5){\r\n    const c4=modulo(modelQ.invariants.c4,p),expected=c4===0?'ADDITIVE':'MULTIPLICATIVE';\r\n    if(expected==='ADDITIVE'&&r.reduction!=='ADDITIVE'||expected==='MULTIPLICATIVE'&&!['SPLIT_MULTIPLICATIVE','NONSPLIT_MULTIPLICATIVE'].includes(r.reduction))fail('Reduction type contradicts c4 and discriminant');\r\n    checkedRules.push('BAD_PRIME_C4_REDUCTION_TYPE_P_GE_5');\r\n    if(expected==='MULTIPLICATIVE'){\r\n     const negativeC6=(p-modulo(modelQ.invariants.c6,p))%p;\r\n     if(!negativeC6)fail('Multiplicative c6 residue cannot vanish');\r\n     const split=square(negativeC6,p);\r\n     if(r.split!==split||r.reduction!==(split?'SPLIT_MULTIPLICATIVE':'NONSPLIT_MULTIPLICATIVE'))fail('Splitting contradicts the nonzero square test for -c6');\r\n     checkedRules.push('NEGATIVE_C6_NONZERO_SQUARE_SPLITTING_P_GE_5');\r\n    }\r\n   }\r\n   if(f>n)fail('Conductor exponent exceeds the discriminant valuation');\n   if(['SPLIT_MULTIPLICATIVE','NONSPLIT_MULTIPLICATIVE'].includes(r.reduction)){\n    const split=r.reduction==='SPLIT_MULTIPLICATIVE';\r\n    if(r.kodaira!=='I'+n||f!==1||w!==0||r.split!==split||cp!==(split?BigInt(n):n%2?1n:2n)||canonical(r.eulerPolynomial)!==canonical(['1',split?'-1':'1']))fail('Multiplicative consistency');\r\n   }else if(r.reduction==='ADDITIVE'){\n    if(f<2||f-w!==2||r.split!==null||canonical(r.eulerPolynomial)!=='[\"1\"]')fail('Additive consistency');\n    if(p>=5){\n     // Only a consistency rule under the submitted p-minimality claim.\n     // v_p(0)=+infinity: j=0 belongs to the potentially good branch.\n     const vj=modelQ.invariants.j==='0'?null:valuation(modelQ.invariants.j,p);\n     let expectedKodaira;\n     if(vj!==null&&vj<0){\n      const m=-vj;\n      if(n!==6+m)fail('Additive discriminant valuation contradicts the pole order of j');\n      expectedKodaira='I'+m+'*';\n     }else{\n      expectedKodaira={2:'II',3:'III',4:'IV',6:'I0*',8:'IV*',9:'III*',10:'II*'}[n];\n      if(!expectedKodaira)fail('Additive discriminant valuation incompatible with claimed tame minimality');\n     }\n     if(r.kodaira!==expectedKodaira)fail('Kodaira label contradicts discriminant and j valuations');\n     checkedRules.push('ADDITIVE_KODAIRA_FROM_DISCRIMINANT_AND_J_P_GE_5');\n    }\n    checkAdditiveTamagawa(r.kodaira,cp);\n   }else fail('Unknown reduction type');\r\n   checkedRules.push('KODAIRA_TAMAGAWA_AND_EULER_CONSISTENCY');\r\n   localAssessments.push({...binding,producerStatus:q.evidence.status,inputRecordHash,\r\n    assessment:'CONSISTENCY_CHECKED_SOURCE_REPORT',checkedRules,localMinimality:'SOURCE_REPORTED_NOT_LOCALLY_VERIFIED',\r\n    tamagawaAssessment:'NOT_LOCALLY_CERTIFIED'});\r\n  }\r\n }\r\n const inventory=packet.badPrimeInventory;if(inventory){evidence(inventory.evidence);if(!packet.minimalModel||packet.minimalModel.scope!=='GLOBAL_Q'||packet.minimalModel.modelId!==inventory.modelId)fail('Inventory lacks global minimal-model claim');let product=1n,lastPrime=1;for(const q of inventory.factors){const p=prime(q.p);if(p<=lastPrime||BigInt(q.exponent)>16384n)fail('Unsorted factorization or exponent cap');lastPrime=p;product*=BigInt(p)**BigInt(q.exponent);if(product.toString(2).length>16384)fail('Factorization product work cap');}product*=BigInt(inventory.remainingCofactor);const d=R(models.get(inventory.modelId).invariants.discriminant);if(d[1]!==1n||product!==(d[0]<0n?-d[0]:d[0])||inventory.complete&&inventory.remainingCofactor!=='1')fail('Incomplete or incorrect discriminant factorization');}\r\n if(packet.aggregate){const q=packet.aggregate;evidence(q.evidence);if(!inventory?.complete||q.modelId!==inventory.modelId||canonical(q.localDataPrimes)!==canonical(inventory.factors.map(f=>f.p)))fail('Aggregate requires all bad primes');let C=1n,N=1n;for(const p of q.localDataPrimes){const r=local.get(p);if(!r?.result||r.modelId!==q.modelId||r.result.reduction==='GOOD')fail('Missing aggregate local data');C*=BigInt(r.result.tamagawaNumber);N*=BigInt(p)**BigInt(r.result.conductorExponent);}if(String(C)!==q.tamagawaProduct||String(N)!==q.conductor)fail('Incorrect aggregate product');}\r\n return {status:'PASS',scope:'EXACT_TRANSPORT_WITH_SCOPED_LOCAL_ASSESSMENTS',localAssessments,tateAssessment:'NOT_IMPLEMENTED',minimalityAssessment:'NOT_IMPLEMENTED',neronAssessment:'NOT_ESTABLISHED_BY_TRANSPORT',bsdPromotion:false};\r\n}\r\nmodule.exports={R,S,add,sub,mul,div,pow,canonical,hash,invariants,model,transform,inverse,compose,pointOn,pointMap,phaseMap,verifyTransport};\r\n","/BSD_TATE_T1_v0_1_20260907/t1.cjs":"'use strict';\n// Bounded T1 proof replay. This is not a full Tate algorithm.\nconst fs=require('node:fs'),path=require('node:path');\nconst C=require('../BSD_MINIMAL_TATE_SCHEMA_v0_3_20260907/model-replay.cjs');\nconst {R,S,hash,canonical,model,transform,compose,pointMap,verifyTransport}=C;\nconst ID={u:'1',r:'0',s:'0',t:'0'};\nconst panels=['MCOMB','CARRIER_ADDITION','ELLIPTIC_MODEL','MARKED_CLIFFORD_LEAF','EXACT_CURVE_BSD','PRIME_PRODUCT'];\nconst fail=m=>{throw Error(m);};\nconst eq=(a,b,m)=>{if(canonical(a)!==canonical(b))fail(m);};\nconst shaFile=f=>require('node:crypto').createHash('sha256').update(fs.readFileSync(f)).digest('hex');\nfunction verifier(){return {name:'BSD_TATE_T1_REPLAY',version:'0.1.0',sha256:shaFile(__filename),arithmeticSha256:shaFile(require.resolve('../BSD_MINIMAL_TATE_SCHEMA_v0_3_20260907/model-replay.cjs'))};}\nfunction context(q){q.contextId=hash({anchor:q.anchor,modelId:q.normalization.targetModelId,normalization:q.normalization,transformations:q.transformations,twistLineage:q.twistLineage});q.panelBindings=panels.map(panel=>({panel,contextId:q.contextId,modelId:q.normalization.targetModelId,normalizationId:hash(q.normalization),markingId:hash(q.marking)}));}\nfunction source(q,body){const bytes=canonical(body),sha256=hash(bytes);if(!q.sources.some(s=>s.sha256===sha256))q.sources.push({sha256,mediaType:'application/json',bytes});return sha256;}\nfunction seed(ainvs,selectedMultiplier='1',points=[]){\n const m=model(ainvs),q={schema:'BSD_MINIMAL_TATE_RECORD_V1',anchor:{inputModelId:m.modelId,sourceHash:'',legacyContextId:null},contextId:'',models:[m],twistLineage:[],transformations:[],normalization:{modelDifferential:'dx/(2*y+a1*x+a3)',sourceSelectedMultiplier:selectedMultiplier,targetModelId:m.modelId,targetSelectedMultiplier:selectedMultiplier,composedPullbackFactor:'1',neron:null},marking:{basisMatrix:[['1','0'],['0','1']],convention:'TARGET_BASIS_EQUALS_U_TIMES_M_SOURCE_BASIS',mcombSourceHash:null,phaseConvention:'FULL_PERIOD_FRACTIONS_MOD_Z2'},points:[],minimalModel:null,localData:[],badPrimeInventory:null,aggregate:null,panelBindings:[],sources:[]};\n q.anchor.sourceHash=source(q,{field:'Q',ainvs,selectedMultiplier});\n q.points=points.map(coordinates=>({modelId:m.modelId,coordinates,sourceHash:source(q,{modelId:m.modelId,coordinates})}));context(q);verifyTransport(q);return q;\n}\nfunction transport(parent,steps){\n verifyTransport(parent);if(!Array.isArray(steps)||steps.length>3)fail('T1 adapter allows at most three additional steps');\n const q=structuredClone(parent),parentTarget=q.normalization.targetModelId,originalPoints=q.points.filter(p=>p.modelId===parentTarget);let composite={...ID};\n // All old claims remain in the bound parent bytes. Child claims are recomputed separately.\n q.minimalModel=null;q.localData=[];q.badPrimeInventory=null;q.aggregate=null;q.normalization.neron=null;\n for(const w of steps){\n  const from=q.models.find(m=>m.modelId===q.normalization.targetModelId),to=model(transform(from.ainvs,w));\n  if(!q.models.some(m=>m.modelId===to.modelId))q.models.push(to);\n  const c=S(C.div(R(q.normalization.targetSelectedMultiplier),R(w.u)));\n  q.transformations.push({fromModelId:from.modelId,toModelId:to.modelId,direction:'SOURCE_TO_TARGET',urst:w,pullbackModelDifferentialFactor:w.u,targetSelectedMultiplier:c});\n  composite=compose(composite,w);q.normalization.targetModelId=to.modelId;q.normalization.targetSelectedMultiplier=c;\n  q.normalization.composedPullbackFactor=S(C.mul(R(q.normalization.composedPullbackFactor),R(w.u)));\n }\n const a=parent.models.find(m=>m.modelId===parentTarget).ainvs;\n // Preserve all old addresses, including repeated visits; append one transported visit per input visit.\n const indices=parent.points.map((p,i)=>p.modelId===parentTarget?i:-1).filter(i=>i>=0);\n const pointTransports=originalPoints.map((p,index)=>{\n  const coordinates=pointMap(a,composite,p.coordinates),modelId=q.normalization.targetModelId;\n  const mapped={modelId,coordinates,sourceHash:source(q,{modelId,coordinates})};q.points.push(mapped);\n  return {sourcePointIndex:indices[index],targetPointIndex:q.points.length-1,sourceHash:p.sourceHash,targetHash:mapped.sourceHash};\n });\n if(q.points.length>200||q.models.length>40||q.transformations.length>16||q.sources.length>300)fail('Transport record work cap');\n context(q);verifyTransport(q);\n return {record:q,adapter:{parentContextId:parent.contextId,sourceModelId:parentTarget,targetModelId:q.normalization.targetModelId,steps,composite,pullbackModelDifferentialFactor:composite.u,targetSelectedMultiplier:q.normalization.targetSelectedMultiplier,pointTransports}};\n}\nfunction clearing(a){let D=1n;const gcd=(a,b)=>b?gcd(b,a%b):a;for(const s of a){const d=R(s)[1];D=D/gcd(D,d)*d;if(D.toString().length>96)fail('Denominator clearing work cap');}const w={u:S([1n,D]),r:'0',s:'0',t:'0'};const out=transform(a,w);out.forEach(s=>{if(R(s)[1]!==1n)fail('Denominator clearing failed');});return w;}\nfunction primeProof(s){if(typeof s!=='string'||! /^(0|[1-9][0-9]*)$/.test(s))fail('Canonical prime required');const p=Number(s);if(!Number.isSafeInteger(p)||p<2||p>1009)fail('UNAVAILABLE: prime proof/count domain is 2..1009');const trials=[];for(let d=2;d*d<=p;d++){const remainder=p%d;if(!remainder)fail('Composite prime');trials.push({divisor:String(d),remainder:String(remainder)});}return {method:'EXHAUSTIVE_TRIAL_DIVISION_TO_SQRT',p:s,trials};}\nfunction valuation(s,p){let [n,d]=R(s);if(!n)return {kind:'INFINITY'};const P=BigInt(p);let exponent=0;while(n%P===0n){n/=P;exponent++;}while(d%P===0n){d/=P;exponent--;}return {kind:'FINITE',exponent:String(exponent),unit:S([n,d])};}\nfunction mod(s,p){const P=BigInt(p),[n,d]=R(s);if(d%P===0n)fail('Non-p-integral model');for(let k=1n;k<P;k++)if(d*k%P===1n)return Number(((n*k)%P+P)%P);fail('No residue inverse');}\nfunction count(a,p){const v=a.map(x=>mod(x,p)),byX=[];let total=1;for(let x=0;x<p;x++){let n=0;for(let y=0;y<p;y++)if(((y*y+v[0]*x*y+v[2]*y-x*x*x-v[1]*x*x-v[3]*x-v[4])%p+p)%p===0)n++;byX.push(String(n));total+=n;}return {reducedAinvs:v.map(String),affineCountsByX:byX,pointsIncludingInfinity:String(total),ap:String(p+1-total)};}\nfunction inventory(m){let remaining=R(m.invariants.discriminant);if(remaining[1]!==1n)fail('Integral model required for inventory');let cofactor=remaining[0]<0n?-remaining[0]:remaining[0];const factors=[];for(let p=2;p<=1009&&cofactor>1n;p++){let proof;try{proof=primeProof(String(p));}catch{continue;}let exponent=0;while(cofactor%BigInt(p)===0n){cofactor/=BigInt(p);exponent++;}if(exponent)factors.push({p:String(p),exponent:String(exponent),primeProof:proof});}return {scope:'MODEL_DISCRIMINANT_SUPPORT_NOT_CURVE_BAD_PRIMES',modelId:m.modelId,absoluteDiscriminant:String(remaining[0]<0n?-remaining[0]:remaining[0]),factors,remainingCofactor:String(cofactor),complete:cofactor===1n,trialDivisionBound:'1009'};}\nfunction trace(record,pString){\n const proof=primeProof(pString),p=Number(pString),m=record.models.find(m=>m.modelId===record.normalization.targetModelId);\n if(m.ainvs.some(x=>R(x)[1]%BigInt(p)===0n))fail('Local model is not p-integral');\n const vd=valuation(m.invariants.discriminant,p),vc4=valuation(m.invariants.c4,p),vc6=valuation(m.invariants.c6,p);\n const base={schema:'BSD_TATE_T1_TRACE_V1',contextId:record.contextId,modelId:m.modelId,normalizationId:hash(record.normalization),markingId:hash(record.marking),p:pString,primeProof:proof,ainvs:m.ainvs,valuations:{discriminant:vd,c4:vc4,c6:vc6},steps:[{operation:'CHECK_P_INTEGRAL',denominatorResidues:m.ainvs.map(s=>String(R(s)[1]%BigInt(p)))},{operation:'VALUATIONS',discriminant:vd,c4:vc4,c6:vc6}],terminal:null};\n if(vd.exponent==='0'){\n  const counts=count(m.ainvs,p);base.steps.push({operation:'UNIT_DISCRIMINANT',residue:String(mod(m.invariants.discriminant,p))},{operation:'COUNT_GOOD_FIBRE',...counts});\n  base.terminal={branch:'GOOD_UNIT_DISCRIMINANT',status:'REPLAYABLE',result:{reduction:'GOOD',kodaira:'I0',split:null,discriminantValuation:'0',conductorExponent:'0',wildConductorContribution:'0',tamagawaNumber:'1',ap:counts.ap,eulerPolynomial:['1',String(-BigInt(counts.ap)),pString],localMinimality:'PROVED_BY_UNIT_DISCRIMINANT'}};\n }else if(p>=5&&vc4.exponent==='0'){\n  const n=Number(vd.exponent),negativeC6=mod(S(C.mul(R('-1'),R(m.invariants.c6))),p),roots=[];if(n<1||!negativeC6)fail('Invalid multiplicative precondition');\n  for(let y=0;y<p;y++)if(y*y%p===negativeC6)roots.push(String(y));const split=roots.length===2;if(![0,2].includes(roots.length))fail('Invalid square root count');\n  base.steps.push({operation:'MULTIPLICATIVE_C4_UNIT',residue:String(mod(m.invariants.c4,p))},{operation:'SPLIT_NEGATIVE_C6',residue:String(negativeC6),roots});\n  base.terminal={branch:'MULTIPLICATIVE_P_GE_5',status:'REPLAYABLE',result:{reduction:split?'SPLIT_MULTIPLICATIVE':'NONSPLIT_MULTIPLICATIVE',kodaira:'I'+n,split,discriminantValuation:String(n),conductorExponent:'1',wildConductorContribution:'0',tamagawaNumber:String(split?n:n%2?1:2),ap:split?'1':'-1',eulerPolynomial:['1',split?'-1':'1'],localMinimality:'PROVED_BY_C4_UNIT'}};\n }else base.terminal={branch:'UNSUPPORTED',status:'UNAVAILABLE',reason:p<5?'WILD_OR_MULTIPLICATIVE_SMALL_CHARACTERISTIC_REQUIRES_T3':'ADDITIVE_BRANCH_REQUIRES_T2'};\n return base;\n}\nfunction assemble(parentBytes,steps,p,backend=null){const parent=JSON.parse(parentBytes),adapted=transport(parent,steps),m=adapted.record.models.find(m=>m.modelId===adapted.record.normalization.targetModelId);return {schema:'BSD_TATE_T1_PACKET_V1',parent:{sha256:hash(parentBytes),bytes:parentBytes},...adapted,inventory:inventory(m),backend,trace:trace(adapted.record,p)};}\nfunction replay(packet){\n if(hash(packet.parent.bytes)!==packet.parent.sha256)fail('Parent bytes hash mismatch');const parent=JSON.parse(packet.parent.bytes),want=transport(parent,packet.adapter.steps);\n eq(packet.record,want.record,'Child transport/context/point replay mismatch');eq(packet.adapter,want.adapter,'Adapter tuple or differential replay mismatch');\n const m=packet.record.models.find(m=>m.modelId===packet.record.normalization.targetModelId);eq(packet.inventory,inventory(m),'Model inventory mismatch');\n const expected=trace(packet.record,packet.trace.p);eq(packet.trace,expected,'Local trace replay mismatch');\n if(packet.backend)require('./pari-adapter.cjs').verifyReport(packet.backend,parent,packet.adapter.steps,packet.trace);\n const bindings={packetHash:hash(packet),parentSourceHash:packet.parent.sha256,contextId:packet.record.contextId,sourceModelId:packet.adapter.sourceModelId,modelId:m.modelId,normalizationId:hash(packet.record.normalization),markingId:hash(packet.record.marking),p:packet.trace.p,traceHash:hash(packet.trace),verifier:verifier()};\n if(expected.terminal.status==='UNAVAILABLE')return {...bindings,status:'UNAVAILABLE',reason:expected.terminal.reason,transportStatus:'PASS',backendAssessment:packet.backend?'REPLAYED_TRANSFORMATIONS_SOURCE_REPORTED_REDUCTION':'ABSENT',certificate:null,bsdPromotion:false};\n const certificate={schema:'BSD_TATE_T1_LOCAL_CERTIFICATE_V1',...bindings,status:'CERTIFIED',scope:'LOCAL_MODEL_AT_ONE_PRIME_ONLY',method:expected.terminal.branch,result:expected.terminal.result,assumptions:[],globalMinimality:'NOT_ASSESSED',neronDifferential:'NOT_ASSESSED',bsdPromotion:false};\n return {...bindings,status:'PASS',transportStatus:'PASS',backendAssessment:packet.backend?'REPLAYED_TRANSFORMATIONS_AND_MATCHING_LOCAL_RESULT':'ABSENT',certificateId:hash(certificate),certificate,bsdPromotion:false};\n}\nmodule.exports={...C,ID,panels,seed,transport,clearing,primeProof,valuation,mod,count,inventory,trace,assemble,replay,verifier,shaFile};\n","/BSD_TATE_T2_v0_1_20260907/finite-field.cjs":"'use strict';\n// Complete factor/root witnesses for degree <=3, over the inherited bounded prime domain.\nconst T=require('../BSD_TATE_T1_v0_1_20260907/t1.cjs');\nfunction polynomial(rationals,pString){\n T.primeProof(pString);const p=Number(pString);if(rationals.length<2||rationals.length>4)throw Error('Polynomial degree cap');\n const mod=n=>(n%p+p)%p,trim=a=>{a=a.slice();while(a.length>1&&a.at(-1)===0)a.pop();return a;};\n const coeffs=trim(rationals.map(x=>T.mod(x,p)));if(coeffs.length!==rationals.length)throw Error('Nonunit polynomial leading coefficient');\n const evalAt=(a,x)=>a.reduceRight((v,c)=>mod(v*x+c),0);\n const quotient=(a,r)=>{const q=Array(a.length-1);q[q.length-1]=a.at(-1);for(let i=q.length-2;i>=0;i--)q[i]=mod(a[i+1]+r*q[i+1]);if(mod(a[0]+r*q[0]))throw Error('Inexact root division');return trim(q);};\n let rest=coeffs.slice();const evaluations=Array.from({length:p},(_,i)=>String(evalAt(coeffs,i))),roots=[];\n for(let x=0;x<p;x++){let multiplicity=0;while(rest.length>1&&evalAt(rest,x)===0){rest=quotient(rest,x);multiplicity++;}if(multiplicity)roots.push({root:String(x),multiplicity:String(multiplicity)});}\n const residualEvaluations=rest.length>1?Array.from({length:p},(_,i)=>String(evalAt(rest,i))):[];\n if(residualEvaluations.includes('0'))throw Error('Incomplete factorization');\n // In degrees 2 and 3, a polynomial with no linear factor is irreducible.\n const residualDegree=rest.length-1;\n return {p:pString,rationalCoefficients:rationals,coefficients:coeffs.map(String),evaluations,roots,residualCoefficients:rest.map(String),residualEvaluations,residualStatus:residualDegree===0?'CONSTANT':'IRREDUCIBLE_DEGREE_'+residualDegree,separable:roots.every(r=>r.multiplicity==='1')};\n}\nmodule.exports={polynomial};\n","/BSD_TATE_T2_v0_1_20260907/tame-tate.cjs":"'use strict';\n// A short-form implementation of tame Tate over Q_p, with exact decision witnesses.\n// It computes from the input equation; no backend result supplies a branch or c_p.\nconst T=require('../BSD_TATE_T1_v0_1_20260907/t1.cjs'),{polynomial}=require('./finite-field.cjs');\nconst {R,S,add,sub,mul,div,pow}=T;\nconst neg=x=>S(mul(R('-1'),R(x))),over=(s,p,e)=>S(div(R(s),pow(R(String(p)),e)));\nconst v=(s,p)=>T.valuation(s,p),ex=(s,p)=>{const a=v(s,p);return a.kind==='INFINITY'?Infinity:Number(a.exponent);};\nfunction compute(ainvs,pString,selectedMultiplier='1'){\n const primeProof=T.primeProof(pString),p=Number(pString);if(p<5)throw Error('UNAVAILABLE: T2 is restricted to 5 <= p <= 1009; use T1 for its small-prime proofs');\n if(ainvs.some(s=>R(s)[1]%BigInt(p)===0n))throw Error('T2 source must be p-integral');\n let a=ainvs.slice(),composite={...T.ID},multiplier=selectedMultiplier;R(multiplier);if(multiplier==='0')throw Error('Zero differential');const events=[];\n const emit=e=>{if(events.length>=512)throw Error('UNAVAILABLE: 512-event trace cap');events.push(e);};\n const change=(purpose,w)=>{const from=a,to=T.transform(a,w),after=S(div(R(multiplier),R(w.u)));to.forEach(R);emit({operation:'MODEL_CHANGE',purpose,fromModelId:T.model(from).modelId,toModelId:T.model(to).modelId,fromAinvs:from,toAinvs:to,urst:w,selectedMultiplierBefore:multiplier,selectedMultiplierAfter:after});a=to;composite=T.compose(composite,w);multiplier=after;};\n const initial=T.model(a),r=S(div(R(neg(initial.invariants.b2)),R('12'))),s=S(div(R(neg(a[0])),R('2')));\n const t=S(div(sub(R('0'),add(R(a[2]),mul(R(a[0]),R(r)))),R('2')));\n change('SHORT_FORM',{u:'1',r,s,t});if(a.slice(0,3).some(s=>s!=='0'))throw Error('Short form failed');\n let scales=0;while(ex(a[3],p)>=4&&ex(a[4],p)>=6){if(++scales>32)throw Error('UNAVAILABLE: 32-rescaling cap');change('REMOVE_P_POWER',{u:pString,r:'0',s:'0',t:'0'});}\n const min=T.model(a),n=ex(min.invariants.discriminant,p),minimality={modelId:min.modelId,shortA:a[3],shortB:a[4],valuationA:v(a[3],p),valuationB:v(a[4],p),criterion:'V_A_LT_4_OR_V_B_LT_6_AT_P_GE_5'};\n emit({operation:'MINIMAL_SHORT',...minimality,discriminantValuation:String(n)});\n function test(name,value,threshold){const valuation=v(value,p),passes=ex(value,p)<threshold;emit({operation:'DIVISIBILITY_TEST',name,value,valuation,threshold:String(threshold),passes});return passes;}\n function poly(purpose,coefficients,xLevel='0',yLevel='0'){const witness=polynomial(coefficients,pString);emit({operation:'RESIDUE_POLYNOMIAL',purpose,xLevel,yLevel,witness});return witness;}\n function finish(kodaira,cp,split=null){\n  let reduction,fp,ap,eulerPolynomial,multiplicities;\n  if(kodaira==='I0'){reduction='GOOD';fp=0;const counted=T.count(a,p);emit({operation:'GOOD_FIBRE_COUNT',...counted});ap=counted.ap;eulerPolynomial=['1',String(-BigInt(ap)),pString];multiplicities=['1'];}\n  else if(/^I[1-9][0-9]*$/.test(kodaira)){const k=Number(kodaira.slice(1));reduction=split?'SPLIT_MULTIPLICATIVE':'NONSPLIT_MULTIPLICATIVE';fp=1;ap=split?'1':'-1';eulerPolynomial=['1',split?'-1':'1'];multiplicities=Array(k).fill('1');}\n  else{reduction='ADDITIVE';fp=2;ap='0';eulerPolynomial=['1'];multiplicities=({II:['1'],III:['1','1'],IV:['1','1','1'],'IV*':['1','1','1','2','2','2','3'],'III*':['1','1','2','2','2','3','3','4'],'II*':['1','2','2','3','3','4','4','5','6']})[kodaira];if(!multiplicities){const k=Number(/^I(\\d+)\\*$/.exec(kodaira)?.[1]);if(!Number.isSafeInteger(k)||k>128)throw Error('UNAVAILABLE: I_n* index cap');multiplicities=['1','1','1','1',...Array(k+1).fill('2')];}}\n  if(multiplicities.length>256)throw Error('UNAVAILABLE: component count cap');\n  const components=multiplicities.length;if(n+1-components!==fp)throw Error('Ogg conductor identity failed');\n  const result={reduction,kodaira,split,discriminantValuation:String(n),conductorExponent:String(fp),wildConductorContribution:'0',tamagawaNumber:String(cp),ap,eulerPolynomial,geometricComponents:String(components),componentMultiplicities:multiplicities,localMinimality:'PROVED_AT_THIS_PRIME',minimalityWitness:minimality};\n  return {schema:'BSD_TAME_TATE_TRACE_V1',p:pString,primeProof,sourceModelId:initial.modelId,sourceAinvs:ainvs,sourceSelectedMultiplier:selectedMultiplier,events,composite,targetModelId:T.model(a).modelId,targetAinvs:a,targetSelectedMultiplier:multiplier,result};\n }\n if(n===0)return finish('I0',1);\n if(ex(min.invariants.c4,p)===0){const w=poly('MULTIPLICATIVE_SPLIT',[min.invariants.c6,'0','1']);const split=w.roots.length===2;return finish('I'+n,split?n:n%2?1:2,split);}\n if(test('TYPE_II',a[4],2))return finish('II',1);\n if(test('TYPE_III',a[3],2))return finish('III',2);\n if(test('TYPE_IV',a[4],3)){const w=poly('TYPE_IV_COMPONENTS',[neg(over(a[4],p,2)),'0','1']);return finish('IV',w.roots.length===2?3:1);}\n const cubic=poly('STAR_CUBIC',[over(a[4],p,3),over(a[3],p,2),'0','1']);\n if(cubic.separable)return finish('I0*',1+cubic.roots.length);\n const repeated=cubic.roots.filter(r=>r.multiplicity!=='1');if(repeated.length!==1)throw Error('Invalid repeated-root cubic');\n const root=repeated[0];change(root.multiplicity==='2'?'CENTER_DOUBLE_ROOT':'CENTER_TRIPLE_ROOT',{u:'1',r:String(BigInt(root.root)*BigInt(p)),s:'0',t:'0'});\n if(root.multiplicity==='2'){\n  let x=2,y=2;\n  for(let round=0;round<64;round++){\n   const wy=poly('STAR_ODD_COMPONENTS',[neg(over(a[4],p,x+y)),'0','1'],String(x),String(y));\n   if(wy.separable)return finish('I'+(x+y-3)+'*',wy.roots.length===2?4:2);\n   if(wy.roots.length!==1||wy.roots[0].root!=='0'||wy.roots[0].multiplicity!=='2')throw Error('Invalid odd double root');\n   emit({operation:'ADVANCE_LEVEL',axis:'Y',from:String(y),to:String(y+1)});y++;\n   const wx=poly('STAR_EVEN_COMPONENTS',[over(a[4],p,x+y),over(a[3],p,x+1),over(a[1],p,1)],String(x),String(y));\n   if(wx.separable)return finish('I'+(x+y-3)+'*',wx.roots.length===2?4:2);\n   if(wx.roots.length!==1||wx.roots[0].multiplicity!=='2')throw Error('Invalid even double root');\n   change('REFINE_DOUBLE_ROOT',{u:'1',r:String(BigInt(wx.roots[0].root)*BigInt(p)**BigInt(x)),s:'0',t:'0'});\n   emit({operation:'ADVANCE_LEVEL',axis:'X',from:String(x),to:String(x+1)});x++;\n  }\n  throw Error('UNAVAILABLE: 64 I_n* refinement rounds');\n }\n if(root.multiplicity!=='3')throw Error('Invalid triple root');\n const w=poly('TYPE_IV_STAR_COMPONENTS',[neg(over(a[4],p,4)),'0','1']);\n if(w.separable)return finish('IV*',w.roots.length===2?3:1);\n if(test('TYPE_III_STAR',a[3],4))return finish('III*',2);\n if(test('TYPE_II_STAR',a[4],6))return finish('II*',1);\n throw Error('Nonminimal terminal contradicts short-form minimality witness');\n}\nmodule.exports={compute};\n","/BSD_TATE_T2_v0_1_20260907/t2.cjs":"'use strict';\nconst assert=require('node:assert/strict'),T=require('../BSD_TATE_T1_v0_1_20260907/t1.cjs'),K=require('./tame-tate.cjs');\nfunction verifier(){return {name:'BSD_TAME_TATE_REPLAY',version:'0.1.0',sha256:T.shaFile(__filename),tateSha256:T.shaFile(require.resolve('./tame-tate.cjs')),finiteFieldSha256:T.shaFile(require.resolve('./finite-field.cjs')),transportSha256:T.shaFile(require.resolve('../BSD_TATE_T1_v0_1_20260907/t1.cjs')),arithmeticSha256:T.shaFile(require.resolve('../BSD_MINIMAL_TATE_SCHEMA_v0_3_20260907/model-replay.cjs'))};}\nfunction kod(code){const n=Number(code);return ({1:'I0',2:'II',3:'III',4:'IV','-1':'I0*','-2':'II*','-3':'III*','-4':'IV*'})[n]||(n>=5?'I'+(n-4):n<=-5?'I'+(-n-4)+'*':null);}\nfunction construct(parentBytes,p,comparison=null){\n const parent=JSON.parse(parentBytes);T.verifyTransport(parent);const source=parent.models.find(m=>m.modelId===parent.normalization.targetModelId),clear=T.clearing(source.ainvs),integral=T.model(T.transform(source.ainvs,clear)),c=T.S(T.div(T.R(parent.normalization.targetSelectedMultiplier),T.R(clear.u)));\n const trace=K.compute(integral.ainvs,p,c),adapted=T.transport(parent,[clear,trace.composite]);\n let comparisonMap=null;if(comparison)comparisonMap=T.compose(T.inverse(adapted.adapter.composite),comparison.adapter.composite);\n return {schema:'BSD_TAME_TATE_PACKET_V1',parent:{sha256:T.hash(parentBytes),bytes:parentBytes},...adapted,integralSource:integral,inventory:T.inventory(integral),trace,comparison,comparisonMap};\n}\nfunction replay(q){\n assert.equal(T.hash(q.parent.bytes),q.parent.sha256,'Parent hash');const expected=construct(q.parent.bytes,q.trace.p,q.comparison);assert.deepEqual(q,expected,'T2 trace/transport/context replay mismatch');\n const r=q.trace.result;\n // Reapply all inherited cheap gates to this proof's target result.\n const local=structuredClone(q.record),bytes=T.canonical(q.trace),sha256=T.hash(bytes);local.sources.push({sha256,mediaType:'application/json',bytes});\n const evidence={status:'UNVERIFIED',method:'T2_REPLAY_CHECK_INPUT',software:'BSD_TAME_TATE_REPLAY_0.1.0',sourceHash:sha256,assumptions:[],dependencies:[],certificate:null};\n const {geometricComponents,componentMultiplicities,localMinimality,minimalityWitness,ap,...oldResult}=r;\n local.localData=[{p:q.trace.p,modelId:q.trace.targetModelId,minimalityEvidence:r.reduction==='GOOD'?null:evidence,result:oldResult,evidence}];T.verifyTransport(local);\n if(q.comparison){\n  assert.deepEqual(q.comparison.parent,q.parent,'Comparison uses a different source');assert.equal(q.comparison.trace.p,q.trace.p,'Comparison prime mismatch');T.replay(q.comparison);\n  const b=q.comparison.backend;if(!b)throw Error('Comparison requires the pinned PARI source report');\n  assert.deepEqual(T.transform(q.trace.targetAinvs,q.comparisonMap),q.comparison.trace.ainvs,'Comparison isomorphism');\n  assert.equal(T.S(T.div(T.R(q.record.normalization.targetSelectedMultiplier),T.R(q.comparisonMap.u))),q.comparison.record.normalization.targetSelectedMultiplier,'Comparison differential');\n  assert.equal(kod(b.claims.LOCAL[1]),r.kodaira,'PARI Kodaira disagreement');assert.equal(b.claims.LOCAL[0],r.conductorExponent,'PARI conductor disagreement');assert.equal(b.claims.LOCAL[3],r.tamagawaNumber,'PARI Tamagawa disagreement');assert.equal(q.comparison.trace.valuations.discriminant.exponent,r.discriminantValuation,'PARI minimal discriminant disagreement');\n  if(q.comparison.trace.terminal.status==='REPLAYABLE'){const old=q.comparison.trace.terminal.result;for(const k of ['reduction','split','ap','eulerPolynomial'])assert.deepEqual(r[k],old[k],'Comparison '+k+' disagreement');}\n }\n const certificate={schema:'BSD_TAME_TATE_LOCAL_CERTIFICATE_V1',status:'CERTIFIED',scope:'ONE_PRIME_P_GE_5_ONLY',packetHash:T.hash(q),parentSourceHash:q.parent.sha256,contextId:q.record.contextId,sourceModelId:q.adapter.sourceModelId,modelId:q.trace.targetModelId,normalizationId:T.hash(q.record.normalization),markingId:T.hash(q.record.marking),p:q.trace.p,traceHash:T.hash(q.trace),verifier:verifier(),method:'EXACT_TAME_TATE_WITH_COMPLETE_RESIDUE_POLYNOMIAL_WITNESSES',result:r,assumptions:[],globalMinimality:'NOT_ASSESSED',neronDifferential:'NOT_ASSESSED',bsdPromotion:false};\n return {status:'PASS',certificateId:T.hash(certificate),certificate,comparisonStatus:q.comparison?'MATCHING_SOURCE_REPORT':'ABSENT',bsdPromotion:false};\n}\nmodule.exports={construct,replay,verifier,kod};\n","/BSD_TATE_T3_v0_1_20260907/small-prime-tate.cjs":"'use strict';\n// General-equation Tate at 2 and 3. Residue choices are exhaustive, never backend supplied.\nconst T=require('../BSD_TATE_T1_v0_1_20260907/t1.cjs'),{polynomial}=require('../BSD_TATE_T2_v0_1_20260907/finite-field.cjs');\nconst {R,S,div,mul,pow}=T,neg=x=>S(mul(R('-1'),R(x))),val=(x,p)=>T.valuation(x,p),ex=(x,p)=>{const v=val(x,p);return v.kind==='INFINITY'?Infinity:Number(v.exponent);};\nfunction compute(ainvs,pString,selectedMultiplier='1'){\n const primeProof=T.primeProof(pString),p=Number(pString);if(![2,3].includes(p))throw Error('UNAVAILABLE: T3 supports only primes 2 and 3; use T2 for tame primes');\n if(ainvs.some(x=>R(x)[1]%BigInt(p)===0n))throw Error('T3 source must be p-integral');\n R(selectedMultiplier);if(selectedMultiplier==='0')throw Error('Zero differential');\n let a=ainvs.slice(),multiplier=selectedMultiplier,composite={...T.ID},scales=0;const initial=T.model(a),events=[];\n const emit=e=>{if(events.length>=2048)throw Error('UNAVAILABLE: 2048-event trace cap');events.push(e);};\n const over=(x,e)=>S(div(R(x),pow(R(pString),e))),times=(x,e)=>String(BigInt(x)*BigInt(p)**BigInt(e));\n const change=(purpose,w)=>{const to=T.transform(a,w),after=S(div(R(multiplier),R(w.u)));to.forEach(R);if(to.some(x=>ex(x,p)<0))throw Error('Nonintegral change');emit({operation:'MODEL_CHANGE',purpose,fromModelId:T.model(a).modelId,toModelId:T.model(to).modelId,fromAinvs:a,toAinvs:to,urst:w,selectedMultiplierBefore:multiplier,selectedMultiplierAfter:after});a=to;multiplier=after;composite=T.compose(composite,w);};\n const translate=(purpose,r='0',s='0',t='0')=>change(purpose,{u:'1',r,s,t});\n const divisibility=(name,value,threshold)=>{const passes=ex(value,p)<threshold;emit({operation:'DIVISIBILITY_TEST',name,value,valuation:val(value,p),threshold:String(threshold),passes});return passes;};\n const requireVal=(name,thresholds)=>{const valuations=a.map(x=>val(x,p));if(a.some((x,i)=>ex(x,p)<thresholds[i]))throw Error('Tate precondition: '+name);emit({operation:'COEFFICIENT_DIVISIBILITY',name,ainvs:a,valuations,thresholds:thresholds.map(String)});};\n const poly=(purpose,coefficients,x=0,y=0)=>{const witness=polynomial(coefficients,pString);emit({operation:'RESIDUE_POLYNOMIAL',purpose,xLevel:String(x),yLevel:String(y),witness});return witness;};\n const doubleRoot=w=>{if(w.separable||w.roots.length!==1||w.roots[0].multiplicity!=='2')throw Error('Expected one double root');return w.roots[0].root;};\n function finish(kodaira,cp,split=null){\n  const target=T.model(a),d=ex(target.invariants.discriminant,p);let reduction,fp,ap,eulerPolynomial,multiplicities,criterion;\n  if(kodaira==='I0'){reduction='GOOD';fp=0;const count=T.count(a,p);emit({operation:'GOOD_FIBRE_COUNT',...count});ap=count.ap;eulerPolynomial=['1',String(-BigInt(ap)),pString];multiplicities=['1'];criterion='UNIT_DISCRIMINANT';}\n  else if(/^I[1-9][0-9]*$/.test(kodaira)){const n=Number(kodaira.slice(1));if(n>256)throw Error('UNAVAILABLE: 256-component cap');reduction=split?'SPLIT_MULTIPLICATIVE':'NONSPLIT_MULTIPLICATIVE';fp=1;ap=split?'1':'-1';eulerPolynomial=['1',split?'-1':'1'];multiplicities=Array(n).fill('1');criterion='UNIT_C4';}\n  else{reduction='ADDITIVE';ap='0';eulerPolynomial=['1'];criterion='TATE_ADDITIVE_TERMINAL';multiplicities=({II:['1'],III:['1','1'],IV:['1','1','1'],'IV*':['1','1','1','2','2','2','3'],'III*':['1','1','2','2','2','3','3','4'],'II*':['1','2','2','3','3','4','4','5','6']})[kodaira];if(!multiplicities){const n=Number(/^I(\\d+)\\*$/.exec(kodaira)?.[1]);if(!Number.isSafeInteger(n)||n>128)throw Error('UNAVAILABLE: I_n* index cap');multiplicities=['1','1','1','1',...Array(n+1).fill('2')];}fp=d+1-multiplicities.length;}\n  const m=multiplicities.length,tame=reduction==='GOOD'?0:reduction==='ADDITIVE'?2:1;\n  if(fp!==d+1-m||fp<tame||fp>(p===2?8:5))throw Error('Ogg/conductor bound failed');\n  const minimalityWitness={criterion,modelId:target.modelId,terminalBranch:kodaira,rescalingCount:String(scales),valuationC4:val(target.invariants.c4,p),valuationDiscriminant:val(target.invariants.discriminant,p)};\n  const conductorWitness={method:'OGG_FROM_TATE_COMPONENT_TYPE',minimalDiscriminantValuation:String(d),geometricComponents:String(m),tameContribution:String(tame)};\n  const result={reduction,kodaira,split,discriminantValuation:String(d),conductorExponent:String(fp),wildConductorContribution:String(fp-tame),tamagawaNumber:String(cp),ap,eulerPolynomial,geometricComponents:String(m),componentMultiplicities:multiplicities,localMinimality:'PROVED_AT_THIS_PRIME',minimalityWitness,conductorWitness};\n  return {schema:'BSD_SMALL_PRIME_TATE_TRACE_V1',p:pString,primeProof,sourceModelId:initial.modelId,sourceAinvs:ainvs,sourceSelectedMultiplier:selectedMultiplier,events,composite,targetModelId:target.modelId,targetAinvs:a,targetSelectedMultiplier:multiplier,result};\n }\n for(;;){\n  const model=T.model(a),d=ex(model.invariants.discriminant,p);emit({operation:'BEGIN_TATE_PASS',modelId:model.modelId,ainvs:a,discriminantValuation:String(d),rescalingCount:String(scales)});\n  if(d===0)return finish('I0',1);\n  // F=0, F_x=0, F_y=0 selects the singular point, including characteristic 2.\n  const b=a.map(x=>T.mod(x,p)),mod=x=>(x%p+p)%p,rows=[],roots=[];\n  for(let x=0;x<p;x++)for(let y=0;y<p;y++){const f=mod(y*y+b[0]*x*y+b[2]*y-x*x*x-b[1]*x*x-b[3]*x-b[4]),fx=mod(b[0]*y-3*x*x-2*b[1]*x-b[3]),fy=mod(2*y+b[0]*x+b[2]);rows.push({x:String(x),y:String(y),f:String(f),fx:String(fx),fy:String(fy)});if(!f&&!fx&&!fy)roots.push({x:String(x),y:String(y)});}\n  if(roots.length!==1)throw Error('Expected unique rational singular point');emit({operation:'SINGULAR_POINT_SEARCH',reducedAinvs:b.map(String),rows,selected:roots[0]});translate('CENTER_SINGULAR_POINT',roots[0].x,'0',roots[0].y);requireVal('SINGULAR_AT_ORIGIN',[0,0,1,1,1]);\n  if(ex(model.invariants.c4,p)===0){const w=poly('MULTIPLICATIVE_TANGENTS',[neg(a[1]),a[0],'1']);if(!w.separable)throw Error('Nonseparable node tangents');const split=w.roots.length===2;return finish('I'+d,split?d:d%2?1:2,split);}\n  const inv=T.model(a).invariants;\n  if(divisibility('TYPE_II',a[4],2))return finish('II',1);\n  if(divisibility('TYPE_III',inv.b8,3))return finish('III',2);\n  if(divisibility('TYPE_IV',inv.b6,3)){const w=poly('TYPE_IV_COMPONENTS',[neg(over(a[4],2)),over(a[2],1),'1']);if(!w.separable)throw Error('Type IV polynomial inseparable');return finish('IV',w.roots.length===2?3:1);}\n  // Search the small finite residue choices for s and t/p, retaining each test.\n  const trials=[],choices=[];for(let s=0;s<p;s++)for(let z=0;z<p;z++){const w={u:'1',r:'0',s:String(s),t:String(p*z)},aa=T.transform(a,w),thresholds=[1,1,2,2,3],passes=aa.every((v,i)=>ex(v,p)>=thresholds[i]);trials.push({s:w.s,t:w.t,passes});if(passes)choices.push(w);}\n  if(!choices.length)throw Error('No additive normalization found');emit({operation:'ADDITIVE_NORMALIZATION_SEARCH',trials,selected:choices[0]});change('NORMALIZE_ADDITIVE',choices[0]);requireVal('STAR_PREPARATION',[1,1,2,2,3]);\n  const cubic=poly('STAR_CUBIC',[over(a[4],3),over(a[3],2),over(a[1],1),'1']);\n  if(cubic.separable)return finish('I0*',1+cubic.roots.length);\n  const repeated=cubic.roots.filter(r=>r.multiplicity!=='1');if(repeated.length!==1)throw Error('Invalid star cubic');const root=repeated[0];\n  translate(root.multiplicity==='2'?'CENTER_DOUBLE_ROOT':'CENTER_TRIPLE_ROOT',times(root.root,1));\n  if(root.multiplicity==='2'){\n   let x=2,y=2;for(let round=0;round<64;round++){\n    const wy=poly('STAR_ODD_COMPONENTS',[neg(over(a[4],x+y)),over(a[2],y),'1'],x,y);\n    if(wy.separable)return finish('I'+(x+y-3)+'*',wy.roots.length===2?4:2);\n    translate('REFINE_Y','0','0',times(doubleRoot(wy),y));emit({operation:'ADVANCE_LEVEL',axis:'Y',from:String(y),to:String(y+1)});y++;\n    const wx=poly('STAR_EVEN_COMPONENTS',[over(a[4],x+y),over(a[3],x+1),over(a[1],1)],x,y);\n    if(wx.separable)return finish('I'+(x+y-3)+'*',wx.roots.length===2?4:2);\n    translate('REFINE_X',times(doubleRoot(wx),x));emit({operation:'ADVANCE_LEVEL',axis:'X',from:String(x),to:String(x+1)});x++;\n   }throw Error('UNAVAILABLE: 64 star-refinement rounds');\n  }\n  if(root.multiplicity!=='3')throw Error('Invalid triple root');requireVal('TRIPLE_ROOT_CENTERED',[1,2,2,3,4]);\n  const w=poly('TYPE_IV_STAR_COMPONENTS',[neg(over(a[4],4)),over(a[2],2),'1']);if(w.separable)return finish('IV*',w.roots.length===2?3:1);\n  translate('CENTER_FINAL_DOUBLE_ROOT','0','0',times(doubleRoot(w),2));requireVal('FINAL_STAR_PREPARATION',[1,2,3,3,5]);\n  if(divisibility('TYPE_III_STAR',a[3],4))return finish('III*',2);\n  if(divisibility('TYPE_II_STAR',a[4],6))return finish('II*',1);\n  requireVal('RESCALING_ALLOWED',[1,2,3,4,6]);if(++scales>32)throw Error('UNAVAILABLE: 32-rescaling cap');change('REMOVE_P_POWER',{u:pString,r:'0',s:'0',t:'0'});\n }\n}\nmodule.exports={compute};\n","/BSD_TATE_T3_v0_1_20260907/t3.cjs":"'use strict';\nconst assert=require('node:assert/strict'),T=require('../BSD_TATE_T1_v0_1_20260907/t1.cjs'),K=require('./small-prime-tate.cjs');\nfunction verifier(){return {name:'BSD_SMALL_PRIME_TATE_REPLAY',version:'0.1.0',sha256:T.shaFile(__filename),tateSha256:T.shaFile(require.resolve('./small-prime-tate.cjs')),finiteFieldSha256:T.shaFile(require.resolve('../BSD_TATE_T2_v0_1_20260907/finite-field.cjs')),transportSha256:T.shaFile(require.resolve('../BSD_TATE_T1_v0_1_20260907/t1.cjs')),arithmeticSha256:T.shaFile(require.resolve('../BSD_MINIMAL_TATE_SCHEMA_v0_3_20260907/model-replay.cjs'))};}\nfunction kod(code){const n=Number(code);return ({1:'I0',2:'II',3:'III',4:'IV','-1':'I0*','-2':'II*','-3':'III*','-4':'IV*'})[n]||(n>=5?'I'+(n-4):n<=-5?'I'+(-n-4)+'*':null);}\nfunction construct(parentBytes,p,comparison=null){\n const parent=JSON.parse(parentBytes);T.verifyTransport(parent);const source=parent.models.find(m=>m.modelId===parent.normalization.targetModelId),clear=T.clearing(source.ainvs),integral=T.model(T.transform(source.ainvs,clear)),c=T.S(T.div(T.R(parent.normalization.targetSelectedMultiplier),T.R(clear.u)));\n const trace=K.compute(integral.ainvs,p,c),adapted=T.transport(parent,[clear,trace.composite]);\n let comparisonMap=null;if(comparison)comparisonMap=T.compose(T.inverse(adapted.adapter.composite),comparison.adapter.composite);\n return {schema:'BSD_SMALL_PRIME_TATE_PACKET_V1',parent:{sha256:T.hash(parentBytes),bytes:parentBytes},...adapted,integralSource:integral,inventory:T.inventory(integral),trace,comparison,comparisonMap};\n}\nfunction replay(q){\n assert.equal(T.hash(q.parent.bytes),q.parent.sha256,'Parent hash');const expected=construct(q.parent.bytes,q.trace.p,q.comparison);assert.deepEqual(q,expected,'T3 trace/transport/context replay mismatch');\n const r=q.trace.result;\n // Reapply all inherited cheap gates to this proof's target result.\n const local=structuredClone(q.record),bytes=T.canonical(q.trace),sha256=T.hash(bytes);local.sources.push({sha256,mediaType:'application/json',bytes});\n const evidence={status:'UNVERIFIED',method:'T3_REPLAY_CHECK_INPUT',software:'BSD_SMALL_PRIME_TATE_REPLAY_0.1.0',sourceHash:sha256,assumptions:[],dependencies:[],certificate:null};\n const {geometricComponents,componentMultiplicities,localMinimality,minimalityWitness,conductorWitness,ap,...oldResult}=r;\n local.localData=[{p:q.trace.p,modelId:q.trace.targetModelId,minimalityEvidence:r.reduction==='GOOD'?null:evidence,result:oldResult,evidence}];T.verifyTransport(local);\n if(q.comparison){\n  assert.deepEqual(q.comparison.parent,q.parent,'Comparison uses a different source');assert.equal(q.comparison.trace.p,q.trace.p,'Comparison prime mismatch');T.replay(q.comparison);\n  const b=q.comparison.backend;if(!b)throw Error('Comparison requires the pinned PARI source report');\n  assert.deepEqual(T.transform(q.trace.targetAinvs,q.comparisonMap),q.comparison.trace.ainvs,'Comparison isomorphism');\n  assert.equal(T.S(T.div(T.R(q.record.normalization.targetSelectedMultiplier),T.R(q.comparisonMap.u))),q.comparison.record.normalization.targetSelectedMultiplier,'Comparison differential');\n  assert.equal(kod(b.claims.LOCAL[1]),r.kodaira,'PARI Kodaira disagreement');assert.equal(b.claims.LOCAL[0],r.conductorExponent,'PARI conductor disagreement');assert.equal(b.claims.LOCAL[3],r.tamagawaNumber,'PARI Tamagawa disagreement');assert.equal(q.comparison.trace.valuations.discriminant.exponent,r.discriminantValuation,'PARI minimal discriminant disagreement');\n  if(q.comparison.trace.terminal.status==='REPLAYABLE'){const old=q.comparison.trace.terminal.result;for(const k of ['reduction','split','ap','eulerPolynomial'])assert.deepEqual(r[k],old[k],'Comparison '+k+' disagreement');}\n }\n const certificate={schema:'BSD_SMALL_PRIME_TATE_LOCAL_CERTIFICATE_V1',status:'CERTIFIED',scope:'ONE_PRIME_2_OR_3_ONLY',packetHash:T.hash(q),parentSourceHash:q.parent.sha256,contextId:q.record.contextId,sourceModelId:q.adapter.sourceModelId,modelId:q.trace.targetModelId,normalizationId:T.hash(q.record.normalization),markingId:T.hash(q.record.marking),p:q.trace.p,traceHash:T.hash(q.trace),verifier:verifier(),method:'EXACT_SMALL_PRIME_TATE_WITH_COMPLETE_RESIDUE_POLYNOMIAL_WITNESSES',result:r,assumptions:[],globalMinimality:'NOT_ASSESSED',neronDifferential:'NOT_ASSESSED',bsdPromotion:false};\n return {status:'PASS',certificateId:T.hash(certificate),certificate,comparisonStatus:q.comparison?'MATCHING_SOURCE_REPORT':'ABSENT',bsdPromotion:false};\n}\nmodule.exports={construct,replay,verifier,kod};\n","/BSD_TATE_T4_v0_1_20260923/global-reduction.cjs":"'use strict';\nconst assert=require('node:assert/strict'),T=require('../BSD_TATE_T1_v0_1_20260907/t1.cjs');\nconst engines={T2:require('../BSD_TATE_T2_v0_1_20260907/t2.cjs'),T3:require('../BSD_TATE_T3_v0_1_20260907/t3.cjs')};\nconst {R,S,add,sub,mul,div,pow}=T;\nconst abs=s=>{const q=R(s);return S([q[0]<0n?-q[0]:q[0],q[1]]);};\nfunction residue(s,m){\n const [n,d]=R(s);if(m===1n)return '0';if(m<=0n||m.toString(2).length>16384)throw Error('Residue modulus cap');\n let a=d,b=m,x=1n,y=0n;while(b){const q=a/b;[a,b]=[b,a-q*b];[x,y]=[y,x-q*y];}\n if(a!==1n)throw Error('Denominator not invertible');return String(((n*x)%m+m)%m);\n}\n// Replace a p-local tuple by an integral tuple with the same u=p^k.\n// The t congruence includes the cross term s*(R-r), required by composition.\nfunction integralLift(w,p){\n const [u,d]=R(w.u);if(d!==1n||u<1n)throw Error('Expected positive integral p-power scale');\n let rem=u;while(rem%BigInt(p)===0n&&rem>1n)rem/=BigInt(p);if(rem!==1n)throw Error('Scale contains another prime');\n const r=residue(w.r,u*u),s=residue(w.s,u),targetT=S(add(R(w.t),mul(R(w.s),sub(R(r),R(w.r))))),t=residue(targetT,u*u*u);\n const lift={u:w.u,r,s,t},localToIntegral=T.compose(T.inverse(w),lift);\n assert.equal(localToIntegral.u,'1');for(const k of ['r','s','t'])if(T.valuation(localToIntegral[k],p).kind==='FINITE'&&Number(T.valuation(localToIntegral[k],p).exponent)<0)throw Error('Nonintegral local equivalence');\n return {lift,localToIntegral,congruences:{rModulus:String(u*u),sModulus:String(u),tModulus:String(u*u*u),tResidueInput:targetT}};\n}\nfunction verifier(){return {name:'BSD_GLOBAL_REDUCTION_REPLAY',version:'0.1.0',sha256:T.shaFile(__filename),transportSha256:T.shaFile(require.resolve('../BSD_TATE_T1_v0_1_20260907/t1.cjs')),arithmeticSha256:T.shaFile(require.resolve('../BSD_MINIMAL_TATE_SCHEMA_v0_3_20260907/model-replay.cjs')),tame:engines.T2.verifier(),smallPrime:engines.T3.verifier()};}\nfunction rebind(q){q.contextId=T.hash({anchor:q.anchor,modelId:q.normalization.targetModelId,normalization:q.normalization,transformations:q.transformations,twistLineage:q.twistLineage});q.panelBindings=T.panels.map(panel=>({panel,contextId:q.contextId,modelId:q.normalization.targetModelId,normalizationId:T.hash(q.normalization),markingId:T.hash(q.marking)}));}\nfunction artifact(q,body){const bytes=T.canonical(body),sha256=T.hash(bytes);if(!q.sources.some(s=>s.sha256===sha256))q.sources.push({sha256,mediaType:'application/json',bytes});return sha256;}\nfunction oldResult(r){return Object.fromEntries(['reduction','kodaira','split','discriminantValuation','conductorExponent','wildConductorContribution','tamagawaNumber','eulerPolynomial'].map(k=>[k,r[k]]));}\nfunction construct(parentBytes){\n const parent=JSON.parse(parentBytes);T.verifyTransport(parent);const parentHash=T.hash(parentBytes),source=parent.models.find(m=>m.modelId===parent.normalization.targetModelId),clear=T.clearing(source.ainvs),integralSource=T.model(T.transform(source.ainvs,clear)),sourceInventory=T.inventory(integralSource);\n if(sourceInventory.factors.length>24)throw Error('UNAVAILABLE: 24-prime global work cap');\n let composite={...T.ID};const stages=[];\n for(const factor of sourceInventory.factors){\n  const p=factor.p,engine=Number(p)<5?'T3':'T2',before=T.transport(parent,[clear,composite]).record,beforeModel=before.models.find(m=>m.modelId===before.normalization.targetModelId);\n  const localPacket=engines[engine].construct(T.canonical(before),p,null),assessment=engines[engine].replay(localPacket);assert.equal(assessment.status,'PASS');\n  const w=localPacket.adapter.composite,lift=integralLift(w,Number(p)),target=T.model(T.transform(beforeModel.ainvs,lift.lift));\n  if(target.ainvs.some(s=>R(s)[1]!==1n))throw Error('Lift did not preserve global integrality');\n  assert.deepEqual(T.transform(localPacket.trace.targetAinvs,lift.localToIntegral),target.ainvs,'Local-to-integral coefficients');\n  const inputDeltaVal=T.valuation(beforeModel.invariants.discriminant,Number(p)),targetDeltaVal=T.valuation(target.invariants.discriminant,Number(p));\n  assert.equal(targetDeltaVal.exponent,assessment.certificate.result.discriminantValuation);\n  const scaleVal=T.valuation(w.u,Number(p));assert.equal(Number(inputDeltaVal.exponent)-Number(targetDeltaVal.exponent),12*Number(scaleVal.exponent));\n  const fromIntegral=composite;composite=T.compose(composite,lift.lift);\n  stages.push({p,engine,sourceModelId:beforeModel.modelId,localPacket,localCertificate:assessment.certificate,localCertificateId:assessment.certificateId,...lift,target,fromIntegral,toIntegral:composite,inputDeltaVal,targetDeltaVal});\n }\n const adapted=T.transport(parent,[clear,composite]),record=adapted.record,model=record.models.find(m=>m.modelId===record.normalization.targetModelId),candidateInventory=T.inventory(model),transfers=[];\n assert.equal(candidateInventory.remainingCofactor,sourceInventory.remainingCofactor,'Unexpected prime support change');\n for(const stage of stages){\n  const p=Number(stage.p),map=T.compose(T.inverse(stage.toIntegral),composite);assert.deepEqual(T.transform(stage.target.ainvs,map),model.ainvs);\n  for(const k of ['u','r','s','t']){const v=T.valuation(map[k],p);if(k==='u'?v.exponent!=='0':v.kind==='FINITE'&&Number(v.exponent)<0)throw Error('Later change damages local minimality');}\n  const cert=stage.localCertificate,r=cert.result;assert.equal(T.valuation(model.invariants.discriminant,p).exponent,r.discriminantValuation);\n  const totalMap=T.compose(stage.localToIntegral,map);assert.deepEqual(T.transform(stage.localPacket.trace.targetAinvs,totalMap),model.ainvs);\n  const selectedBefore=stage.localPacket.record.normalization.targetSelectedMultiplier;assert.equal(S(div(R(selectedBefore),R(totalMap.u))),record.normalization.targetSelectedMultiplier);\n  transfers.push({p:stage.p,localCertificateId:stage.localCertificateId,localModelId:stage.localPacket.trace.targetModelId,globalCandidateModelId:model.modelId,integralStageToFinal:map,localToFinal:totalMap,localMinimality:'TRANSFERRED_BY_P_INTEGRAL_UNIT_ISOMORPHISM',result:oldResult(r),ap:r.ap});\n }\n const knownBad=transfers.filter(t=>t.result.reduction!=='GOOD'),recoveredGood=transfers.filter(t=>t.result.reduction==='GOOD').map(t=>t.p);\n assert.deepEqual(knownBad.map(t=>t.p),candidateInventory.factors.map(f=>f.p));\n let conductor=1n,tamagawa=1n;for(const t of knownBad){conductor*=BigInt(t.p)**BigInt(t.result.conductorExponent);tamagawa*=BigInt(t.result.tamagawaNumber);}\n for(const n of [conductor,tamagawa])if(n.toString().length>96)throw Error('UNAVAILABLE: product size cap');\n const knownPrimeProducts={scope:'ONLY_LISTED_PRIMES',primes:knownBad.map(t=>t.p),conductor:String(conductor),tamagawaProduct:String(tamagawa)};\n const complete=candidateInventory.complete;\n const normalization=complete?{convention:'GLOBAL_MINIMAL_MODEL_DIFFERENTIAL_UP_TO_SIGN',chosenSign:'MODEL_DIFFERENTIAL',modelId:model.modelId,inputModelId:source.modelId,anchorModelId:parent.anchor.inputModelId,signedPullbackToInput:adapted.adapter.composite.u,signedPullbackToAnchor:record.normalization.composedPullbackFactor,selectedMultiplier:record.normalization.targetSelectedMultiplier,neronOverSelectedMultiplier:S(div(R('1'),R(record.normalization.targetSelectedMultiplier))),absoluteRealMeasureFactorFromInput:abs(adapted.adapter.composite.u),absoluteRealMeasureFactorFromAnchor:abs(record.normalization.composedPullbackFactor),absoluteRealMeasureFactorFromSelected:abs(S(div(R('1'),R(record.normalization.targetSelectedMultiplier)))),realComponents:R(model.invariants.discriminant)[0]>0n?'2':'1',periodValue:'NOT_COMPUTED'}:null;\n const globalResult=complete?{modelId:model.modelId,minimalDiscriminant:model.invariants.discriminant,curveBadPrimes:knownBad.map(t=>t.p),conductor:String(conductor),tamagawaProduct:String(tamagawa),goodOutsideInventory:'PROVED_BY_INTEGRAL_MODEL_AND_UNIT_DISCRIMINANT',normalization}:null;\n const proof={schema:'BSD_GLOBAL_REDUCTION_PROOF_V1',parentSourceHash:parentHash,sourceInventory,candidateInventory,stageHashes:stages.map(T.hash),transfers,knownPrimeProducts,recoveredGood,globalResult,verifier:verifier()};\n const dependencies=stages.map(s=>artifact(record,s.localCertificate)),proofHash=artifact(record,proof);\n const evidence={status:'CERTIFIED',method:'T4_EXACT_GLOBAL_REPLAY',software:'BSD_GLOBAL_REDUCTION_REPLAY_0.1.0',sourceHash:proofHash,assumptions:[],dependencies,certificate:{artifactSha256:proofHash,verifier:'BSD_GLOBAL_REDUCTION_REPLAY_0.1.0',conclusion:complete?'GLOBAL_MINIMAL_NERON_AND_REDUCTION_PRODUCTS':'LOCAL_RESULTS_AT_LISTED_PRIMES_ONLY'}};\n record.localData=transfers.map(t=>({p:t.p,modelId:model.modelId,minimalityEvidence:t.result.reduction==='GOOD'?null:evidence,result:t.result,evidence}));\n if(complete){record.minimalModel={modelId:model.modelId,scope:'GLOBAL_Q',prime:null,evidence};record.normalization.neron={modelId:model.modelId,convention:'GLOBAL_MINIMAL_MODEL_DIFFERENTIAL_UP_TO_SIGN',evidence};record.badPrimeInventory={modelId:model.modelId,factors:candidateInventory.factors.map(({p,exponent})=>({p,exponent})),remainingCofactor:'1',complete:true,evidence};record.aggregate={modelId:model.modelId,conductor:String(conductor),tamagawaProduct:String(tamagawa),localDataPrimes:knownBad.map(t=>t.p),evidence};}\n if(record.sources.length>300)throw Error('UNAVAILABLE: source artifact count cap');rebind(record);T.verifyTransport(record);\n return {schema:'BSD_GLOBAL_REDUCTION_PACKET_V1',parent:{sha256:parentHash,bytes:parentBytes},integralSource,sourceInventory,stages,adapter:adapted.adapter,record,candidateInventory,proof,proofHash};\n}\nfunction replay(q){\n assert.equal(T.hash(q.parent.bytes),q.parent.sha256,'Parent hash');const expected=construct(q.parent.bytes);assert.deepEqual(q,expected,'T4 global replay mismatch');\n if(!q.candidateInventory.complete)return {status:'UNAVAILABLE',reason:'UNRESOLVED_DISCRIMINANT_COFACTOR',remainingCofactor:q.candidateInventory.remainingCofactor,packetHash:T.hash(q),proofHash:q.proofHash,localCertificates:q.stages.map(s=>s.localCertificateId),knownPrimeProducts:q.proof.knownPrimeProducts,globalMinimality:'NOT_ASSESSED',neronDifferential:'NOT_ASSESSED',certificate:null,bsdPromotion:false};\n const certificate={schema:'BSD_GLOBAL_REDUCTION_CERTIFICATE_V1',status:'CERTIFIED',scope:'GLOBAL_REDUCTION_OVER_Q_WITHIN_DECLARED_BOUNDS',packetHash:T.hash(q),parentSourceHash:q.parent.sha256,contextId:q.record.contextId,sourceModelId:q.adapter.sourceModelId,modelId:q.record.normalization.targetModelId,normalizationId:T.hash(q.record.normalization),markingId:T.hash(q.record.marking),proofHash:q.proofHash,localCertificateIds:q.stages.map(s=>s.localCertificateId),verifier:verifier(),method:'INTEGRAL_LOCAL_LIFTS_COMPLETE_FACTORISATION_AND_LOCAL_CERTIFICATE_REPLAY',result:q.proof.globalResult,globalMinimality:'CERTIFIED',neronDifferential:'CERTIFIED_UP_TO_SIGN',heights:'NOT_COMPUTED',bsdPromotion:false};\n return {status:'PASS',certificateId:T.hash(certificate),certificate,localCertificates:certificate.localCertificateIds,bsdPromotion:false};\n}\nmodule.exports={construct,replay,verifier,integralLift,residue};\n","/v27_elliptic_bridge.js":"/* Clifford elliptic bridge v0.1, 2026-09-07.\n * Exact rational model arithmetic is independent of Float64 periods and the host.\n * Standalone companion: embedded verbatim in monodromy.27 by the build script. */\nconst EllipticModelV27 = (() => {\n  'use strict';\n  const abs = n => n < 0n ? -n : n;\n  const gcd = (a,b) => { a=abs(a); b=abs(b); while(b) [a,b]=[b,a%b]; return a; };\n  function rat(n,d=1n) { if(!d) throw Error('Denominator must be nonzero.'); if(d<0n){n=-n;d=-d;} const g=gcd(n,d); return {n:n/g,d:d/g}; }\n  function parse(value) {\n    const s=String(value).trim();\n    if(s.length>200 || !/^[+-]?\\d{1,96}(?:\\/[+-]?\\d{1,96})?$/.test(s)) throw Error('Use integers or fractions, at most 96 digits per integer.');\n    const [n,d='1']=s.split('/'); return rat(BigInt(n),BigInt(d));\n  }\n  const str = r => r.d===1n ? String(r.n) : `${r.n}/${r.d}`;\n  const add = (a,b) => rat(a.n*b.d+b.n*a.d,a.d*b.d);\n  const mul = (a,b) => rat(a.n*b.n,a.d*b.d);\n  const div = (a,b) => rat(a.n*b.d,a.d*b.n);\n  const pow = (a,k) => rat(a.n**BigInt(k),a.d**BigInt(k));\n  const scale = (a,n) => mul(a,rat(BigInt(n)));\n  const number = a => Number(a.n)/Number(a.d);\n  const mod1 = a => rat((a.n%a.d+a.d)%a.d,a.d);\n  const pack = a => ({num:String(a.n),den:String(a.d)});\n  const cmp = (a,b) => { const d=a.n*b.d-b.n*a.d; return d<0n?-1:d>0n?1:0; };\n  function sqrtInt(n) { if(n<0n) throw Error('Negative integer root.'); if(n<2n)return n; let x=1n<<BigInt(Math.ceil(n.toString(2).length/2)); for(;;){const y=(x+n/x)/2n;if(y>=x)return x;x=y;} }\n  function fourthRoot(r) { if(r.n<=0n)return null; const n=sqrtInt(sqrtInt(r.n)),d=sqrtInt(sqrtInt(r.d)); return n**4n===r.n && d**4n===r.d ? rat(n,d):null; }\n  const rationalCM = new Map([\n    ['-262537412640768000',-163],['-147197952000',-67],['-884736000',-43],['-12288000',-27],\n    ['-884736',-19],['-32768',-11],['-3375',-7],['0',-3],['1728',-4],['8000',-8],\n    ['54000',-12],['287496',-16],['16581375',-28]\n  ]);\n  // These integral reference models are minimal: every v_p(Delta) is <12.\n  // A reduction of an integral discriminant would subtract a positive multiple of 12.\n  const minimalReferences = [\n    {A:'-1',B:'0',id:'E_MINUS_ONE',delta:'64',valuations:{2:6}},\n    {A:'-25',B:'0',id:'E_CONGRUENT_FIVE',delta:'1000000',valuations:{2:6,5:6}},\n    {A:'1',B:'0',id:'E_PLUS_ONE',delta:'-64',valuations:{2:6}}\n  ];\n  function neron(A,B) {\n    if(B.n===0n) for(const ref of minimalReferences) {\n      const u=fourthRoot(div(A,parse(ref.A)));\n      if(u) return {status:'VERIFIED_REFERENCE_ISOMORPHISM',reference:ref,\n        coordinateChange:'x_model = u^2 x_reference; y_model = u^3 y_reference',u:pack(u),\n        factorOfModelDifferential:pack(u),differential:'omega_N = u * dx_model/(2 y_model)'};\n    }\n    return {status:'NOT_VERIFIED',factorOfModelDifferential:null,differential:'Only the displayed model differential is normalized.'};\n  }\n  function agm(a,b) {\n    if(!(a>0&&b>0))throw Error('AGM arguments must be positive.');\n    for(let i=0;i<60;i++){const x=(a+b)/2,y=Math.sqrt(a*b);if(Math.abs(x-y)<=4*Number.EPSILON*x)return x;a=x;b=y;}\n    throw Error('AGM did not converge.');\n  }\n  const ellipticK = m => Math.PI/(2*agm(1,Math.sqrt(1-m)));\n  const complexScale = (z,c) => z.map(x=>x*c);\n  const complexAdd = (z,w) => [z[0]+w[0],z[1]+w[1]];\n  function periods(A,B,discriminant,j) {\n    if(cmp(j,rat(1728n))<0) return {status:'OUTSIDE_RECTANGULAR_FAMILY',reason:'Exact j < 1728. This model needs a nonrectangular conformal structure.'};\n    const a=number(A),b=number(B);\n    if(!Number.isFinite(a)||!Number.isFinite(b)||Math.abs(a)>1e80||Math.abs(b)>1e80||\n      (A.n!==0n && Math.abs(a)<1e-80)||(B.n!==0n && Math.abs(b)<1e-80))\n      return {status:'NUMERICAL_RANGE_UNSUPPORTED',reason:'Exact invariants retained; coefficients exceed the supported Float64 period range.'};\n    if(B.n===0n && A.n>0n) {\n      // Square complex torus with rotated real structure. Real cycle is (1,-1).\n      const r=2*ellipticK(.5)/Math.pow(a,.25),h=r/2;\n      return {status:'FLOAT64_APPROXIMATION',method:'AGM_SQUARE_ROTATED_REAL_FORM',tauImag:1,rho:1,eta:Math.PI/4,\n        basis:[[h,h],[-h,h]],realCycle:['1','-1'],realComponents:1,primitiveReal:r,realTotal:r,\n        realStructure:'ROTATED_SQUARE_ONE_REAL_COMPONENT',roots:null,lambda:null,\n        reason:'The real cycle is omega1 - omega2; neither Clifford coordinate cycle alone is real.'};\n    }\n    if(discriminant.n<=0n) return {status:'UNSUPPORTED_REAL_STRUCTURE',reason:'No implemented marked rectangular model for this real form.'};\n    const xScale=Math.max(Math.sqrt(Math.abs(a)),Math.cbrt(Math.abs(b)));\n    const an=a/(xScale*xScale),bn=b/(xScale*xScale*xScale);\n    const radius=2*Math.sqrt(-an/3),arg=3*bn/(2*an)*Math.sqrt(-3/an);\n    if(!Number.isFinite(arg)||Math.abs(arg)>=1-1e-12)\n      return {status:'ILL_CONDITIONED_NEAR_SINGULAR',reason:'Exact model is nonsingular; Float64 roots are too close for this period adapter.'};\n    const angle=Math.acos(arg)/3;\n    const roots=[0,1,2].map(k=>radius*Math.cos(angle-2*Math.PI*k/3)).sort((x,y)=>y-x);\n    const span=roots[0]-roots[2],lambda=(roots[1]-roots[2])/span;\n    if(!(lambda>1e-10&&lambda<1-1e-10))return {status:'ILL_CONDITIONED_NEAR_SINGULAR',reason:'Root separation is outside the supported period window.'};\n    const denominator=Math.sqrt(span)*Math.sqrt(xScale);\n    const wr=2*ellipticK(lambda)/denominator,wi=2*ellipticK(1-lambda)/denominator,t=wi/wr;\n    const jApprox=256*(1-lambda+lambda*lambda)**3/(lambda*lambda*(1-lambda)**2);\n    const jExactApprox=number(j),relativeJResidual=Math.abs(jApprox-jExactApprox)/Math.max(1,Math.abs(jExactApprox));\n    if(!Number.isFinite(relativeJResidual)||relativeJResidual>1e-8)return {status:'NUMERICAL_CONCORDANCE_FAILED',reason:'Root-based j did not agree with the exact rational invariant.'};\n    return {status:'FLOAT64_APPROXIMATION',method:'THREE_REAL_ROOTS_AGM',tauImag:t,rho:1/t,eta:Math.atan(t),\n      basis:[[wr,0],[0,wi]],realCycle:['1','0'],realComponents:2,primitiveReal:wr,realTotal:2*wr,\n      realStructure:'RECTANGULAR_TWO_REAL_COMPONENTS',roots:roots.map(x=>x*xScale),lambda,jApprox,relativeJResidual};\n  }\n  function build(input) {\n    const A0=parse(input.A),B0=parse(input.B),factor=parse(input.twistFactor??'1'),c=parse(input.differentialFactor??'1');\n    if(!factor.n)throw Error('Twist factor must be nonzero.');\n    if(c.n<=0n)throw Error('Differential multiplier must be positive to retain the displayed orientation.');\n    const kind=input.twistKind??'none';let A=A0,B=B0;\n    if(kind==='quadratic'){A=mul(A0,pow(factor,2));B=mul(B0,pow(factor,3));}\n    else if(kind==='quartic'){if(B0.n!==0n||A0.n===0n)throw Error('Quartic twists require B=0 and A nonzero (j=1728).');A=mul(A0,factor);}\n    else if(kind!=='none')throw Error('Unknown twist kind.');\n    else if(cmp(factor,rat(1n))!==0)throw Error('With no twist, set the factor to 1.');\n    const D=add(scale(pow(A,3),4),scale(pow(B,2),27));\n    if(!D.n)throw Error('Singular cubic: 4A^3 + 27B^2 = 0. There is no elliptic curve.');\n    const delta=scale(D,-16),c4=scale(A,-48),j=div(scale(pow(A,3),6912),D);\n    const normalization=neron(A,B),approx=periods(A,B,delta,j);\n    if(approx.status==='FLOAT64_APPROXIMATION') {\n      const cf=number(c);\n      if(!(cf>=1e-80&&cf<=1e80))throw Error('Differential multiplier is outside the supported numerical range.');\n      approx.selectedBasis=approx.basis.map(z=>complexScale(z,cf));\n      approx.selectedPrimitiveReal=cf*approx.primitiveReal;approx.selectedRealTotal=cf*approx.realTotal;\n      approx.neronRealTotal=normalization.factorOfModelDifferential ? number(rat(BigInt(normalization.factorOfModelDifferential.num),BigInt(normalization.factorOfModelDifferential.den)))*approx.realTotal : null;\n    }\n    const key=str(j);\n    return {schema:'CLIFFORD_ELLIPTIC_MODEL_V1',input:{A:str(A0),B:str(B0),twistKind:kind,twistFactor:str(factor),differentialFactor:str(c)},\n      exact:{A:pack(A),B:pack(B),discriminant:pack(delta),c4:pack(c4),j:pack(j),\n        twistClass:kind==='quartic'?'factor modulo Q* fourth powers':kind==='quadratic'?'factor modulo Q* squares':'specified model, no twist',\n        cm:{status:rationalCM.has(key)?'CM_RATIONAL_J':'NON_CM_RATIONAL_J',orderDiscriminant:rationalCM.get(key)??null},\n        differential:{factor:pack(c),basis:'dx/(2y)'},neron:normalization},\n      display:approx,arithmeticClaims:{rank:'NOT_COMPUTED',regulator:'NOT_COMPUTED',sha:'NOT_COMPUTED',bsd:'NOT_TESTED'}};\n  }\n  function marking(pText,qText,model,folded=false) {\n    const p=parse(pText),q=parse(qText);if(p.d!==1n||q.d!==1n)throw Error('Winding coordinates must be integers.');\n    const d=model.display;if(d.status!=='FLOAT64_APPROXIMATION')throw Error('Period display unavailable.');\n    const basis=folded?[d.selectedBasis[1],complexScale(d.selectedBasis[0],-1)]:d.selectedBasis;\n    const P=folded?q.n:p.n,Q=folded?-p.n:q.n;\n    return {source:[String(p.n),String(q.n)],coordinates:[String(P),String(Q)],basis,\n      period:complexAdd(complexScale(basis[0],Number(P)),complexScale(basis[1],Number(Q))),\n      tauImag:folded?1/d.tauImag:d.tauImag,folded};\n  }\n  function phase(thetaPi,betaPi,folded=false) {\n    // Divide before reducing: source phases are multiples of pi, lattice phases of 2pi.\n    const a=mod1(div(parse(thetaPi),rat(2n))),b=mod1(div(parse(betaPi),rat(2n)));\n    const coords=folded?[b,mod1(scale(a,-1))]:[a,b];\n    const order=a.d/gcd(a.d,b.d)*b.d;\n    return {coordinates:coords.map(pack),order:String(order),standing:'TORSION_ON_COMPLEX_CURVE; RATIONALITY_OF_CUBIC_COORDINATES_NOT_INFERRED'};\n  }\n  return Object.freeze({build,marking,phase,parse,str,pack,rat,number,gcd,mul,div,mod1,agm,ellipticK});\n})();\nif(typeof module!=='undefined'&&module.exports)module.exports=EllipticModelV27;\n\n/* Browser adapter. It reads the exact index and changes only display sweep state. */\nif(typeof document!=='undefined') {\nwindow.CliffordEllipticBridgeV27 = (() => {\n  'use strict';\n  const M=EllipticModelV27,$=id=>document.getElementById(id);\n  let model=null,bound=false,dirty=false,folded=false,lastPoint=null,loading=false;\n  const ui=document.createElement('section');ui.id='elliptic-bridge-v27';\n  ui.innerHTML=`<style>\n  #elliptic-bridge-v27{border:1px solid #536785;border-radius:9px;padding:16px;margin:12px 0;background:#101827;color:#dbe7f8;font:13px/1.5 system-ui;min-width:0}\n  #elliptic-bridge-v27 *{box-sizing:border-box}#elliptic-bridge-v27 h2{font-size:18px;margin:0 0 4px;color:#87e7e3}\n  #elliptic-bridge-v27 p{margin:6px 0 12px}#elliptic-bridge-v27 .eb-fields{display:flex;gap:10px;flex-wrap:wrap;align-items:end}\n  #elliptic-bridge-v27 label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:#b4c8df;max-width:100%}\n  #elliptic-bridge-v27 input,#elliptic-bridge-v27 select,#elliptic-bridge-v27 button{font:inherit;color:#e8f2ff;background:#16243a;border:1px solid #536785;border-radius:5px;padding:7px;max-width:100%}\n  #elliptic-bridge-v27 input{width:110px}#elliptic-bridge-v27 button{cursor:pointer}#elliptic-bridge-v27 button:disabled{opacity:.45;cursor:default}\n  #elliptic-bridge-v27 #eb-apply{background:#164b51;border-color:#61d6d0}#elliptic-bridge-v27 :focus-visible{outline:2px solid #fcd675;outline-offset:2px}\n  #elliptic-bridge-v27 .eb-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;margin-top:14px}\n  #elliptic-bridge-v27 dl{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:7px 12px;margin:0}#elliptic-bridge-v27 dt{color:#9dafc6}#elliptic-bridge-v27 dd{margin:0;overflow-wrap:anywhere}\n  #elliptic-bridge-v27 code{color:#a8eeec;white-space:normal;overflow-wrap:anywhere}#elliptic-bridge-v27 small{color:#a6b6ce}\n  #elliptic-bridge-v27 [hidden]{display:none!important}#eb-status{padding:8px;border-left:3px solid #67d9d4;background:#0b1220;overflow-wrap:anywhere}\n  #eb-status[data-error=true]{border-color:#fda4af;color:#fecdd3}#eb-chart svg{width:100%;display:block;background:#0a1220;border-radius:6px}\n  #eb-import{width:240px}#eb-point{overflow-wrap:anywhere}#elliptic-bridge-v27 details{margin-top:12px}\n  @media(max-width:720px){#elliptic-bridge-v27 .eb-grid{grid-template-columns:1fr}#elliptic-bridge-v27{padding:11px}#elliptic-bridge-v27 dl{grid-template-columns:1fr}#elliptic-bridge-v27 dd{margin-bottom:5px}}\n  </style>\n  <h2>Elliptic model → marked Clifford leaf</h2>\n  <p>Choose exact coefficients and a twist. The model determines the displayed period ratio; the Fourier phases keep their addresses.</p>\n  <div class=\"eb-fields\"><label>Examples<select id=\"eb-preset\"><option value=\"minus\">Square · y² = x³ − x</option><option value=\"five\">Quadratic twist d = 5</option><option value=\"generic\">Rectangular · y² = x³ − 2x + 1</option><option value=\"plus\">Same square · y² = x³ + x</option><option value=\"scaled\">Rescaled model · y² = x³ − 16x</option><option value=\"outside\">Outside family · y² = x³ + x + 1</option><option value=\"custom\">Custom coefficients</option></select></label>\n  <label>Base A<input id=\"eb-a\" value=\"-1\" aria-label=\"Exact base A\"></label><label>Base B<input id=\"eb-b\" value=\"0\" aria-label=\"Exact base B\"></label>\n  <label>Twist<select id=\"eb-twist\"><option value=\"none\">None</option><option value=\"quadratic\">Quadratic · A d², B d³</option><option value=\"quartic\">Quartic · A d, B = 0</option></select></label><label>Factor d<input id=\"eb-factor\" value=\"1\"></label>\n  <label>Differential c · dx/(2y)<input id=\"eb-differential\" value=\"1\" aria-label=\"Positive rational differential multiplier\"></label>\n  </div><div class=\"eb-fields\" style=\"margin:12px 0\"><button id=\"eb-apply\">Apply model → leaf</button><button id=\"eb-detach\">Detach from sweep</button><button id=\"eb-export\">Export bridge JSON</button></div>\n  <div id=\"eb-status\" role=\"status\" aria-live=\"polite\"></div>\n  <div id=\"eb-results\" class=\"eb-grid\"><div><dl id=\"eb-invariants\"></dl><p id=\"eb-real\"></p><small>Coefficients, j, Δ and markings are exact. Periods, η and the picture are Float64 approximations; no interval error certificate.</small></div>\n  <div><div id=\"eb-chart\"></div><div class=\"eb-fields\" style=\"margin-top:8px\"><label>Cycle p<input id=\"eb-p\" value=\"1\"></label><label>Cycle q<input id=\"eb-q\" value=\"0\"></label><button id=\"eb-use-orbit\">Use indexed winding</button><button id=\"eb-fold\" aria-pressed=\"false\">Fold chart basis</button></div><p id=\"eb-winding\"></p><p id=\"eb-point\"></p></div></div>\n  <details><summary>Normalization, scope and saved models</summary><p>ω₀ = dx/(2y). Choosing c = 2 displays dx/y and doubles its periods. Ω_E is labeled only when a rational isomorphism to a verified minimal reference model establishes the Néron differential.</p><p>The continuous rectangular family covers j ≥ 1728. Its endpoints are degenerate. Folding the chart sends (p,q) → (q,−p), changes the chart basis, and leaves the host’s registered phases untouched. For the rotated real form y² = x³ + Ax, A &gt; 0, the real cycle is (1,−1).</p><p>CM is determined here from the exact rational j, using the complete rational CM list. Rank, regulator and Sha are not computed. A rational phase gives complex torsion, without asserting rational cubic coordinates.</p><label>Load exported bridge JSON<input id=\"eb-import\" type=\"file\" accept=\".json,application/json\"></label><small>Only exact inputs and the marking are accepted from the file; all results are recomputed. Loading does not bind the host until Apply.</small></details>`;\n  $('orbit-point-index').insertAdjacentElement('beforebegin',ui);\n  const f = x => Number.isFinite(x)?Number(x.toPrecision(11)).toString():'unavailable';\n  const z = a => `${f(a[0])}${a[1]<0?' − ':' + '}${f(Math.abs(a[1]))}i`;\n  const rationalText = a => a.den==='1'?a.num:`${a.num}/${a.den}`;\n  const data = () => ({A:$('eb-a').value,B:$('eb-b').value,twistKind:$('eb-twist').value,twistFactor:$('eb-factor').value,differentialFactor:$('eb-differential').value});\n  function message(text,error=false){$('eb-status').textContent=text;$('eb-status').dataset.error=String(error);}\n  function canBind(){return model&&!dirty&&model.display.status==='FLOAT64_APPROXIMATION';}\n  function isBound(){return bound&&canBind()&&state.cliffordLeafMode==='sweep';}\n  function detach(redraw=true){bound=false;if(redraw){render();refresh();}}\n  function invalidate(){dirty=true;bound=false;lastPoint=null;$('eb-results').hidden=true;$('eb-export').disabled=true;message('Inputs changed. Apply to recompute; the previous model is detached.');render();}\n  function apply(bind=true) {\n    try {\n      const next=M.build(data());model=next;dirty=false;bound=false;lastPoint=null;$('eb-results').hidden=false;$('eb-export').disabled=false;\n      if(bind&&canBind()){\n        const s=liftSourceSnapshot(),rho=arithmeticRhoForSnapshot(s);\n        if(leafSweepAvailable(s,rho)){\n          stopCliffordLeafSweepAnimation();stopMeridionalSweepAnimation();state.cliffordSweepMode='off';syncMeridionalSweepControls();\n          state.cliffordLeafEtaStep=leafEtaStepFromRho(next.display.rho);state.cliffordLeafMode='sweep';bound=true;\n        }\n      }\n      render();refresh();return true;\n    }catch(e){model=null;bound=false;dirty=true;lastPoint=null;$('eb-results').hidden=true;$('eb-export').disabled=true;message(e.message,true);render();return false;}\n  }\n  function line(dl,label,value){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=label;dd.textContent=value;dl.append(dt,dd);}\n  function selectedPoint(){\n    const e=OrbitPointIndexV26.selected,s=liftSourceSnapshot();\n    if(!leafSweepAvailable(s,arithmeticRhoForSnapshot(s)))return null;\n    if(!e||!e.phase.exact||!isBound()||Math.abs(e.eta-model.display.eta)>1e-11)return null;\n    try{return {address:{lane:e.p.lane,N:String(e.p.N),c:String(e.p.c),sExact:e.p.indexSExact??null},\n      phasePi:{theta1:e.phase.theta,beta:e.phase.beta},...M.phase(e.phase.theta,e.phase.beta,folded),\n      source:'INDEXED_POINT_OR_HELD_RULER; NOT_A_NEW_GENERATED_POINT'};}catch{return null;}\n  }\n  function chart(mark,point){\n    const host=$('eb-chart');host.replaceChildren();const ns='http://www.w3.org/2000/svg';\n    const el=(tag,attrs,text)=>{const e=document.createElementNS(ns,tag);for(const [k,v] of Object.entries(attrs))e.setAttribute(k,String(v));if(text)e.textContent=text;return e;};\n    const svg=el('svg',{viewBox:'0 0 460 290',role:'img','aria-label':'Marked period lattice, opposite sides identified'});\n    const t=mark.tauImag,maxW=330,maxH=180,w=Math.min(maxW,maxH/t),h=w*t,x=(460-w)/2,y=42;\n    svg.append(el('rect',{x,y,width:w,height:h,fill:'#11263a',stroke:'#596d8a'}));\n    for(const xx of [x,x+w])svg.append(el('line',{x1:xx,y1:y,x2:xx,y2:y+h,stroke:'#6ce6e0','stroke-width':2}));\n    for(const yy of [y,y+h])svg.append(el('line',{x1:x,y1:yy,x2:x+w,y2:yy,stroke:'#c5a3ff','stroke-width':2}));\n    // A based cycle is displayed with seam crossings split, never joined across the chart.\n    const [P,Q]=mark.coordinates.map(Number);\n    if(Math.abs(P)+Math.abs(Q)<=512){\n      const cuts=[0,1];for(const n of [Math.abs(P),Math.abs(Q)])for(let k=1;k<n;k++)cuts.push(k/n);\n      cuts.sort((a,b)=>a-b);\n      for(let i=1;i<cuts.length;i++){\n        const a=cuts[i-1],b=cuts[i];if(b-a<1e-14)continue;const mid=(a+b)/2,ix=Math.floor(P*mid),iy=Math.floor(Q*mid);\n        svg.append(el('line',{x1:x+(P*a-ix)*w,y1:y+h-(Q*a-iy)*h,x2:x+(P*b-ix)*w,y2:y+h-(Q*b-iy)*h,stroke:'#ffcf70','stroke-width':1.5,'data-period-cycle':'true'}));\n      }\n    }else svg.append(el('text',{x:15,y:237,fill:'#ffcf70','font-size':11},'Cycle drawing omitted above 512 total windings; integral retained.'));\n    svg.append(el('text',{x:15,y:20,fill:'#cdddf1','font-size':12},`τ = ${f(t)}i · ${folded?'folded marking':'model marking'}`));\n    svg.append(el('text',{x:15,y:254,fill:'#6ce6e0','font-size':12},`ω₁ ≈ ${z(mark.basis[0])}`));\n    svg.append(el('text',{x:15,y:275,fill:'#c5a3ff','font-size':12},`ω₂ ≈ ${z(mark.basis[1])}`));\n    if(point){const a=point.coordinates.map(r=>Number(r.num)/Number(r.den));svg.append(el('circle',{cx:x+a[0]*w,cy:y+h-a[1]*h,r:5,fill:'#ffdd78',stroke:'#fff'}));}\n    host.append(svg);\n  }\n  function refresh(){\n    ui.hidden=!['plane','clifford'].includes(state.viewMode);\n    if(!model||dirty)return;\n    const e=model.exact,d=model.display,dl=$('eb-invariants');dl.replaceChildren();\n    line(dl,'Exact model',`y² = x³ + (${rationalText(e.A)})x + (${rationalText(e.B)})`);\n    line(dl,'j',rationalText(e.j));line(dl,'Δ',rationalText(e.discriminant));\n    line(dl,'CM',e.cm.status==='CM_RATIONAL_J'?`Yes · order discriminant ${e.cm.orderDiscriminant}`:'No · exact rational j is outside the rational CM list');\n    $('eb-detach').disabled=!bound;\n    if(d.status!=='FLOAT64_APPROXIMATION'){\n      message(d.reason,true);$('eb-chart').textContent='No leaf binding for this model.';$('eb-winding').textContent='';$('eb-point').textContent='';$('eb-real').textContent='Rank, regulator and Sha: not computed.';return;\n    }\n    const s=liftSourceSnapshot(),active=isBound()&&leafSweepAvailable(s,arithmeticRhoForSnapshot(s));\n    message(active?`Model bound · ρ_display ≈ ${f(d.rho)} · η ≈ ${f(d.eta/Math.PI)}π · off-grid period calculation`:bound?'Model binding suspended: host has no two-phase anchor (N=0 or n₆=0).':'Model ready · Apply to drive the Clifford leaf.');\n    line(dl,'τ / leaf ρ',`${f(d.tauImag)}i / ${f(d.rho)}`);\n    line(dl,'Differential',`${rationalText(e.differential.factor)} · dx/(2y)`);\n    line(dl,'Primitive real period',`≈ ${f(d.selectedPrimitiveReal)} · selected differential`);\n    line(dl,'Integral over E(ℝ)',`≈ ${f(d.selectedRealTotal)} · ${d.realComponents} component${d.realComponents===1?'':'s'}`);\n    if(d.neronRealTotal!==null){line(dl,'Néron normalization',`${rationalText(e.neron.factorOfModelDifferential)} · dx/(2y) · verified reference isomorphism`);line(dl,'Ω_E',`≈ ${f(d.neronRealTotal)} · Néron differential; independent of display multiplier c`);}\n    else line(dl,'Ω_E','Unavailable · Néron normalization not verified for this model');\n    $('eb-real').textContent=d.realStructure==='ROTATED_SQUARE_ONE_REAL_COMPONENT'?'Rotated real structure: the real cycle is (1,−1). The coordinate cycles are complex.':'Real structure: θ₁ follows the identity component; the other component is its half-imaginary-period translate.';\n    try {\n      const mark=M.marking($('eb-p').value,$('eb-q').value,model,folded);lastPoint=active?selectedPoint():null;chart(mark,lastPoint);\n      $('eb-winding').textContent=`Cycle (${mark.source.join(', ')})${folded?` → (${mark.coordinates.join(', ')})`:''}; ∫ω ≈ ${z(mark.period)}. ${folded?'Chart fold only; the host leaf and phases are unchanged.':''}`;\n      $('eb-point').textContent=lastPoint?`Indexed/ruler point: lattice coordinates (${lastPoint.coordinates.map(rationalText).join(', ')}); exact complex torsion order ${lastPoint.order}. Cubic-coordinate rationality is not inferred.`:'Bind the model and select an exact indexed point to transport its phase address.';\n    }catch(e){$('eb-winding').textContent=e.message;}\n  }\n  function useOrbit(){\n    try{\n      const e=OrbitPointIndexV26.selected,s=liftSourceSnapshot();if(!e)throw Error('Select an indexed orbit first.');\n      const t1=M.parse(s.t1Exact),t2=M.parse(s.t2Exact),L=t1.d/M.gcd(t1.d,t2.d)*t2.d;\n      const P=BigInt(e.p.N)*t1.n*(L/t1.d),Q=-BigInt(e.p.c)*t2.n*(L/t2.d),g=M.gcd(P,Q);\n      $('eb-p').value=String(g?P/g:0n);$('eb-q').value=String(g?Q/g:0n);refresh();\n    }catch(e){message(e.message,true);}\n  }\n  function snapshot(){\n    if(!model||dirty)throw Error('Apply valid model inputs before exporting.');\n    const p=M.parse($('eb-p').value),q=M.parse($('eb-q').value);\n    if(p.d!==1n||q.d!==1n)throw Error('Winding coordinates must be integers before exporting.');\n    const s=liftSourceSnapshot();\n    return {schema:'CLIFFORD_ELLIPTIC_BRIDGE_V1',version:'0.1',model,\n      marking:{p:M.str(p),q:M.str(q),folded},\n      binding:{requested:bound,active:isBound()&&leafSweepAvailable(s,arithmeticRhoForSnapshot(s)),mode:'DISPLAY_ONLY_MODEL_DRIVES_LEAF'},\n      selectedPoint:selectedPoint(),provenance:{host:document.title,modelAuthority:'EXACT_RATIONAL_INPUT',periodAuthority:'FLOAT64_APPROXIMATION_NOT_INTERVAL_CERTIFICATE',\n        existingFourierExports:'ARITHMETIC_REGISTER_UNCHANGED',noRankInference:true}};\n  }\n  function importRecord(record){\n    if(!record||record.schema!=='CLIFFORD_ELLIPTIC_BRIDGE_V1'||!record.model?.input)throw Error('Not a bridge V1 file.');\n    const next=M.build(record.model.input),p=M.parse(record.marking?.p??'1'),q=M.parse(record.marking?.q??'0');\n    if(p.d!==1n||q.d!==1n)throw Error('Imported windings must be integers.');\n    const i=next.input;for(const [id,key] of [['eb-a','A'],['eb-b','B'],['eb-factor','twistFactor'],['eb-twist','twistKind'],['eb-differential','differentialFactor']])$(id).value=i[key];\n    $('eb-p').value=M.str(p);$('eb-q').value=M.str(q);folded=record.marking?.folded===true;$('eb-fold').setAttribute('aria-pressed',String(folded));$('eb-preset').value='custom';\n    return apply(false);\n  }\n  $('eb-apply').onclick=()=>apply(true);$('eb-detach').onclick=()=>detach();$('eb-use-orbit').onclick=useOrbit;\n  $('eb-fold').onclick=()=>{folded=!folded;$('eb-fold').setAttribute('aria-pressed',String(folded));refresh();};\n  for(const id of ['eb-a','eb-b','eb-twist','eb-factor','eb-differential'])$(id).addEventListener('input',()=>{if(!loading){$('eb-preset').value='custom';invalidate();}});\n  for(const id of ['eb-p','eb-q'])$(id).addEventListener('input',refresh);\n  $('eb-preset').onchange=()=>{\n    const presets={minus:['-1','0','none','1'],five:['-1','0','quadratic','5'],generic:['-2','1','none','1'],plus:['-1','0','quartic','-1'],scaled:['-16','0','none','1'],outside:['1','1','none','1']};\n    const row=presets[$('eb-preset').value];if(!row)return;loading=true;\n    ['eb-a','eb-b','eb-twist','eb-factor'].forEach((id,k)=>$(id).value=row[k]);$('eb-differential').value='1';loading=false;apply(true);\n  };\n  $('eb-export').onclick=()=>{try{const record=snapshot(),blob=new Blob([JSON.stringify(record,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='clifford-elliptic-bridge-v1.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}catch(e){message(e.message,true);}};\n  $('eb-import').onchange=async event=>{try{const file=event.target.files[0];if(!file)return;if(file.size>1000000)throw Error('Bridge file exceeds 1 MB.');importRecord(JSON.parse(await file.text()));}catch(e){invalidate();message(e.message,true);}finally{event.target.value='';}};\n  // Explicit host sweep controls relinquish the model binding before their old handlers.\n  for(const id of ['btn-leaf-arithmetic','btn-leaf-sweep','btn-leaf-balance','btn-leaf-play',\n    'btn-sweep-off','btn-sweep-slice','btn-sweep-volume','btn-sweep-follow','btn-sweep-travel','btn-sweep-play','btn-sweep-reset'])\n    $(id)?.addEventListener('click',()=>detach(false),true);\n  $('leaf-eta-slider').addEventListener('input',()=>detach(false),true);\n  const api={refresh,apply,detach,snapshot,importRecord,isBound,get eta(){return model?.display.eta;},get model(){return model;},get folded(){return folded;},\n    syncControls(){if(!isBound())return;const s=liftSourceSnapshot();if(!leafSweepAvailable(s,arithmeticRhoForSnapshot(s)))return;\n      $('leaf-eta-slider').disabled=true;$('btn-leaf-play').disabled=true;\n      $('leaf-eta-value').textContent=`model η≈${f(model.display.eta/Math.PI)}π · ρ_display≈${f(model.display.rho)}`;\n      $('leaf-sweep-help').textContent='Exact model drives an approximate off-grid leaf. Detach to use the sweep slider. Fourier arithmetic remains unchanged.';},\n    initialize(){apply(false);}};\n  return api;\n})();\n}\n","/BSD_CURVE_RECORD_v0_1_20260907/bsd-record.js":"/* BSD curve record v0.1. Exact rational bookkeeping; no analytic-rank oracle. */\n(function(root,factory){\n  if(typeof module==='object'&&module.exports) module.exports=factory(require('../v27_elliptic_bridge.js'),require('node:crypto').webcrypto);\n  else root.BSDRecord=factory(EllipticModelV27,root.crypto);\n})(typeof window==='object'?window:globalThis,(M,crypto)=>{\n  'use strict';\n  const VERSION='BSD_CURVE_RECORD_V1', CAP=2000000;\n  const conventions={\n    real_period:'NERON_TOTAL_REAL_INTEGRAL',analytic_rank:'ORD_S1_L_UNCOMPLETED',\n    leading_term:'L_DERIVATIVE_AT_1_DIVIDED_BY_R_FACTORIAL',algebraic_rank:'RANK_E_Q',\n    rational_points:'AFFINE_POINTS_ON_REGISTERED_SHORT_MODEL',torsion_order:'ORDER_E_Q_TORS',\n    regulator:'NERON_TATE_DETERMINANT_FULL_MW_BASIS_OVER_Q',\n    tamagawa:'ALL_BAD_PRIMES_WITH_GOOD_ELSEWHERE',sha_order:'INDEPENDENT_FINITE_GROUP_ORDER',\n    sha_bsd_report:'CONDITIONAL_BSD_INFERRED_ORDER',l_function:'UNCOMPLETED_L_SERIES_GOOD_PRIME_FACTORS',l_values:'UNCOMPLETED_L_E_S_VALUES'};\n  const statuses=['NUMERICAL','RIGOROUS_BOUND','CERTIFIED','CONDITIONAL'];\n  const clone=x=>JSON.parse(JSON.stringify(x));\n  function fail(s){throw Error(s);}\n  function keys(x,expected,label){if(!x||typeof x!=='object'||Array.isArray(x)||Object.keys(x).sort().join('|')!==[...expected].sort().join('|'))fail('Invalid fields: '+label);}\n  function text(x,max=1000){if(typeof x!=='string'||!x.trim()||x.length>max)fail('Expected bounded nonempty text');return x;}\n  function bounded(x){let stack=[[x,0]],n=0;while(stack.length){const [v,d]=stack.pop();if(d>24||++n>60000)fail('Object complexity limit');if(v&&typeof v==='object')for(const w of Object.values(v))stack.push([w,d+1]);}re