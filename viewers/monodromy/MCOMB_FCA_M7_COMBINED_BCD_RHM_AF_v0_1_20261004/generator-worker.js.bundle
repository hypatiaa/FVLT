      exact:{A:pack(A),B:pack(B),discriminant:pack(delta),c4:pack(c4),j:pack(j),
        twistClass:kind==='quartic'?'factor modulo Q* fourth powers':kind==='quadratic'?'factor modulo Q* squares':'specified model, no twist',
        cm:{status:rationalCM.has(key)?'CM_RATIONAL_J':'NON_CM_RATIONAL_J',orderDiscriminant:rationalCM.get(key)??null},
        differential:{factor:pack(c),basis:'dx/(2y)'},neron:normalization},
