  for(const id of ['eb-p','eb-q'])$(id).addEventListener('input',refresh);
  $('eb-preset').onchange=()=>{
    const presets={minus:['-1','0','none','1'],five:['-1','0','quadratic','5'],generic:['-2','1','none','1'],plus:['-1','0','quartic','-1'],scaled:['-16','0','none','1'],outside:['1','1','none','1']};
