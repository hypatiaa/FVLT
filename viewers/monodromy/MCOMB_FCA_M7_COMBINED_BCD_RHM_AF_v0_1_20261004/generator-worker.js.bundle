/* Browser adapter. It reads the exact index and changes only display sweep state. */
if(typeof document!=='undefined') {
window.CliffordEllipticBridgeV27 = (() => {
  'use strict';
  const M=EllipticModelV27,$=id=>document.getElementById(id);
  let model=null,bound=false,dirty=false,folded=false,lastPoint=null,loading=false;
  const ui=document.createElement('section');ui.id='elliptic-bridge-v27';
  ui.innerHTML=`<style>
  #elliptic-bridge-v27{border:1px solid #536785;border-radius:9px;padding:16px;margin:12px 0;background:#101827;color:#dbe7f8;font:13px/1.5 system-ui;min-width:0}
  #elliptic-bridge-v27 *{box-sizing:border-box}#elliptic-bridge-v27 h2{font-size:18px;margin:0 0 4px;color:#87e7e3}
  #elliptic-bridge-v27 p{margin:6px 0 12px}#elliptic-bridge-v27 .eb-fields{display:flex;gap:10px;flex-wrap:wrap;align-items:end}
  #elliptic-bridge-v27 label{display:flex;flex-direction:column;gap:4px;font-size:12px;color:#b4c8df;max-width:100%}
  #elliptic-bridge-v27 input,#elliptic-bridge-v27 select,#elliptic-bridge-v27 button{font:inherit;color:#e8f2ff;background:#16243a;border:1px solid #536785;border-radius:5px;padding:7px;max-width:100%}
  #elliptic-bridge-v27 input{width:110px}#elliptic-bridge-v27 button{cursor:pointer}#elliptic-bridge-v27 button:disabled{opacity:.45;cursor:default}
  #elliptic-bridge-v27 #eb-apply{background:#164b51;border-color:#61d6d0}#elliptic-bridge-v27 :focus-visible{outline:2px solid #fcd675;outline-offset:2px}
  #elliptic-bridge-v27 .eb-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;margin-top:14px}
  #elliptic-bridge-v27 dl{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:7px 12px;margin:0}#elliptic-bridge-v27 dt{color:#9dafc6}#elliptic-bridge-v27 dd{margin:0;overflow-wrap:anywhere}
  #elliptic-bridge-v27 code{color:#a8eeec;white-space:normal;overflow-wrap:anywhere}#elliptic-bridge-v27 small{color:#a6b6ce}
  #elliptic-bridge-v27 [hidden]{display:none!important}#eb-status{padding:8px;border-left:3px solid #67d9d4;background:#0b1220;overflow-wrap:anywhere}
  #eb-status[data-error=true]{border-color:#fda4af;color:#fecdd3}#eb-chart svg{width:100%;display:block;background:#0a1220;border-radius:6px}
  #eb-import{width:240px}#eb-point{overflow-wrap:anywhere}#elliptic-bridge-v27 details{margin-top:12px}
  @media(max-width:720px){#elliptic-bridge-v27 .eb-grid{grid-template-columns:1fr}#elliptic-bridge-v27{padding:11px}#elliptic-bridge-v27 dl{grid-template-columns:1fr}#elliptic-bridge-v27 dd{margin-bottom:5px}}
  </style>
  <h2>Elliptic model → marked Clifford leaf</h2>
  <p>Choose exact coefficients and a twist. The model determines the displayed period ratio; the Fourier phases keep their addresses.</p>
  <div class="eb-fields"><label>Examples<select id="eb-preset"><option value="minus">Square · y² = x³ − x</option><option value="five">Quadratic twist d = 5</option><option value="generic">Rectangular · y² = x³ − 2x + 1</option><option value="plus">Same square · y² = x³ + x</option><option value="scaled">Rescaled model · y² = x³ − 16x</option><option value="outside">Outside family · y² = x³ + x + 1</option><option value="custom">Custom coefficients</option></select></label>
  <label>Base A<input id="eb-a" value="-1" aria-label="Exact base A"></label><label>Base B<input id="eb-b" value="0" aria-label="Exact base B"></label>
  <label>Twist<select id="eb-twist"><option value="none">None</option><option value="quadratic">Quadratic · A d², B d³</option><option value="quartic">Quartic · A d, B = 0</option></select></label><label>Factor d<input id="eb-factor" value="1"></label>
  <label>Differential c · dx/(2y)<input id="eb-differential" value="1" aria-label="Positive rational differential multiplier"></label>
  </div><div class="eb-fields" style="margin:12px 0"><button id="eb-apply">Apply model → leaf</button><button id="eb-detach">Detach from sweep</button><button id="eb-export">Export bridge JSON</button></div>
  <div id="eb-status" role="status" aria-live="polite"></div>
  <div id="eb-results" class="eb-grid"><div><dl id="eb-invariants"></dl><p id="eb-real"></p><small>Coefficients, j, Δ and markings are exact. Periods, η and the picture are Float64 approximations; no interval error certificate.</small></div>
  <div><div id="eb-chart"></div><div class="eb-fields" style="margin-top:8px"><label>Cycle p<input id="eb-p" value="1"></label><label>Cycle q<input id="eb-q" value="0"></label><button id="eb-use-orbit">Use indexed winding</button><button id="eb-fold" aria-pressed="false">Fold chart basis</button></div><p id="eb-winding"></p><p id="eb-point"></p></div></div>
  <details><summary>Normalization, scope and saved models</summary><p>ω₀ = dx/(2y). Choosing c = 2 displays dx/y and doubles its periods. Ω_E is labeled only when a rational isomorphism to a verified minimal reference model establishes the Néron differential.</p><p>The continuous rectangular family covers j ≥ 1728. Its endpoints are degenerate. Folding the chart sends (p,q) → (q,−p), changes the chart basis, and leaves the host’s registered phases untouched. For the rotated real form y² = x³ + Ax, A &gt; 0, the real cycle is (1,−1).</p><p>CM is determined here from the exact rational j, using the complete rational CM list. Rank, regulator and Sha are not computed. A rational phase gives complex torsion, without asserting rational cubic coordinates.</p><label>Load exported bridge JSON<input id="eb-import" type="file" accept=".json,application/json"></label><small>Only exact inputs and the marking are accepted from the file; all results are recomputed. Loading does not bind the host until Apply.</small></details>`;
  $('orbit-point-index').insertAdjacentElement('beforebegin',ui);
  const f = x => Number.isFinite(x)?Number(x.toPrecision(11)).toString():'unavailable';
  const z = a => `${f(a[0])}${a[1]<0?' − ':' + '}${f(Math.abs(a[1]))}i`;
  const rationalText = a => a.den==='1'?a.num:`${a.num}/${a.den}`;
  const data = () => ({A:$('eb-a').value,B:$('eb-b').value,twistKind:$('eb-twist').value,twistFactor:$('eb-factor').value,differentialFactor:$('eb-differential').value});
  function message(text,error=false){$('eb-status').textContent=text;$('eb-status').dataset.error=String(error);}
  function canBind(){return model&&!dirty&&model.display.status==='FLOAT64_APPROXIMATION';}
  function isBound(){return bound&&canBind()&&state.cliffordLeafMode==='sweep';}
  function detach(redraw=true){bound=false;if(redraw){render();refresh();}}
  function invalidate(){dirty=true;bound=false;lastPoint=null;$('eb-results').hidden=true;$('eb-export').disabled=true;message('Inputs changed. Apply to recompute; the previous model is detached.');render();}
  function apply(bind=true) {
    try {
      const next=M.build(data());model=next;dirty=false;bound=false;lastPoint=null;$('eb-results').hidden=false;$('eb-export').disabled=false;
      if(bind&&canBind()){
        const s=liftSourceSnapshot(),rho=arithmeticRhoForSnapshot(s);
        if(leafSweepAvailable(s,rho)){
          stopCliffordLeafSweepAnimation();stopMeridionalSweepAnimation();state.cliffordSweepMode='off';syncMeridionalSweepControls();
          state.cliffordLeafEtaStep=leafEtaStepFromRho(next.display.rho);state.cliffordLeafMode='sweep';bound=true;
        }
      }
      render();refresh();return true;
    }catch(e){model=null;bound=false;dirty=true;lastPoint=null;$('eb-results').hidden=true;$('eb-export').disabled=true;message(e.message,true);render();return false;}
  }
  function line(dl,label,value){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=label;dd.textContent=value;dl.append(dt,dd);}
  function selectedPoint(){
    const e=OrbitPointIndexV26.selected,s=liftSourceSnapshot();
    if(!leafSweepAvailable(s,arithmeticRhoForSnapshot(s)))return null;
    if(!e||!e.phase.exact||!isBound()||Math.abs(e.eta-model.display.eta)>1e-11)return null;
    try{return {address:{lane:e.p.lane,N:String(e.p.N),c:String(e.p.c),sExact:e.p.indexSExact??null},
      phasePi:{theta1:e.phase.theta,beta:e.phase.beta},...M.phase(e.phase.theta,e.phase.beta,folded),
      source:'INDEXED_POINT_OR_HELD_RULER; NOT_A_NEW_GENERATED_POINT'};}catch{return null;}
  }
  function chart(mark,point){
    const host=$('eb-chart');host.replaceChildren();const ns='http://www.w3.org/2000/svg';
    const el=(tag,attrs,text)=>{const e=document.createElementNS(ns,tag);for(const [k,v] of Object.entries(attrs))e.setAttribute(k,String(v));if(text)e.textContent=text;return e;};
    const svg=el('svg',{viewBox:'0 0 460 290',role:'img','aria-label':'Marked period lattice, opposite sides identified'});
    const t=mark.tauImag,maxW=330,maxH=180,w=Math.min(maxW,maxH/t),h=w*t,x=(460-w)/2,y=42;
    svg.append(el('rect',{x,y,width:w,height:h,fill:'#11263a',stroke:'#596d8a'}));
    for(const xx of [x,x+w])svg.append(el('line',{x1:xx,y1:y,x2:xx,y2:y+h,stroke:'#6ce6e0','stroke-width':2}));
    for(const yy of [y,y+h])svg.append(el('line',{x1:x,y1:yy,x2:x+w,y2:yy,stroke:'#c5a3ff','stroke-width':2}));
    // A based cycle is displayed with seam crossings split, never joined across the chart.
    const [P,Q]=mark.coordinates.map(Number);
    if(Math.abs(P)+Math.abs(Q)<=512){
      const cuts=[0,1];for(const n of [Math.abs(P),Math.abs(Q)])for(let k=1;k<n;k++)cuts.push(k/n);
      cuts.sort((a,b)=>a-b);
      for(let i=1;i<cuts.length;i++){
        const a=cuts[i-1],b=cuts[i];if(b-a<1e-14)continue;const mid=(a+b)/2,ix=Math.floor(P*mid),iy=Math.floor(Q*mid);
        svg.append(el('line',{x1:x+(P*a-ix)*w,y1:y+h-(Q*a-iy)*h,x2:x+(P*b-ix)*w,y2:y+h-(Q*b-iy)*h,stroke:'#ffcf70','stroke-width':1.5,'data-period-cycle':'true'}));
      }
    }else svg.append(el('text',{x:15,y:237,fill:'#ffcf70','font-size':11},'Cycle drawing omitted above 512 total windings; integral retained.'));
    svg.append(el('text',{x:15,y:20,fill:'#cdddf1','font-size':12},`τ = ${f(t)}i · ${folded?'folded marking':'model marking'}`));
    svg.append(el('text',{x:15,y:254,fill:'#6ce6e0','font-size':12},`ω₁ ≈ ${z(mark.basis[0])}`));
    svg.append(el('text',{x:15,y:275,fill:'#c5a3ff','font-size':12},`ω₂ ≈ ${z(mark.basis[1])}`));
    if(point){const a=point.coordinates.map(r=>Number(r.num)/Number(r.den));svg.append(el('circle',{cx:x+a[0]*w,cy:y+h-a[1]*h,r:5,fill:'#ffdd78',stroke:'#fff'}));}
    host.append(svg);
  }
  function refresh(){
    ui.hidden=!['plane','clifford'].includes(state.viewMode);
    if(!model||dirty)return;
    const e=model.exact,d=model.display,dl=$('eb-invariants');dl.replaceChildren();
    line(dl,'Exact model',`y² = x³ + (${rationalText(e.A)})x + (${rationalText(e.B)})`);
    line(dl,'j',rationalText(e.j));line(dl,'Δ',rationalText(e.discriminant));
    line(dl,'CM',e.cm.status==='CM_RATIONAL_J'?`Yes · order discriminant ${e.cm.orderDiscriminant}`:'No · exact rational j is outside the rational CM list');
    $('eb-detach').disabled=!bound;
    if(d.status!=='FLOAT64_APPROXIMATION'){
      message(d.reason,true);$('eb-chart').textContent='No leaf binding for this model.';$('eb-winding').textContent='';$('eb-point').textContent='';$('eb-real').textContent='Rank, regulator and Sha: not computed.';return;
    }
    const s=liftSourceSnapshot(),active=isBound()&&leafSweepAvailable(s,arithmeticRhoForSnapshot(s));
    message(active?`Model bound · ρ_display ≈ ${f(d.rho)} · η ≈ ${f(d.eta/Math.PI)}π · off-grid period calculation`:bound?'Model binding suspended: host has no two-phase anchor (N=0 or n₆=0).':'Model ready · Apply to drive the Clifford leaf.');
    line(dl,'τ / leaf ρ',`${f(d.tauImag)}i / ${f(d.rho)}`);
    line(dl,'Differential',`${rationalText(e.differential.factor)} · dx/(2y)`);
    line(dl,'Primitive real period',`≈ ${f(d.selectedPrimitiveReal)} · selected differential`);
    line(dl,'Integral over E(ℝ)',`≈ ${f(d.selectedRealTotal)} · ${d.realComponents} component${d.realComponents===1?'':'s'}`);
    if(d.neronRealTotal!==null){line(dl,'Néron normalization',`${rationalText(e.neron.factorOfModelDifferential)} · dx/(2y) · verified reference isomorphism`);line(dl,'Ω_E',`≈ ${f(d.neronRealTotal)} · Néron differential; independent of display multiplier c`);}
