  }
  function marking(pText,qText,model,folded=false) {
    const p=parse(pText),q=parse(qText);if(p.d!==1n||q.d!==1n)throw Error('Winding coordinates must be integers.');
    const d=model.display;if(d.status!=='FLOAT64_APPROXIMATION')throw Error('Period display unavailable.');
