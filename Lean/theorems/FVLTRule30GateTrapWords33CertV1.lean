private def timingCodes : List Nat :=
  [49415, 13534, 20836, 18882, 952, 4055, 14554, 30072, 13719, 22298, 23208, 31399]

private def timingOrigins : List Nat :=
  if timingCodes.length == 12 &&
      (List.range 12).all (fun i =>
        let c := timingCodes.getD i 0
        trapCodes.contains c &&
          slotMatches ((observations33 5).getD i none) ((decode c).headD false)) &&
      (timingCodes.zip (timingCodes.drop 1)).all (fun p =>
        anySuccessor (codeMask [p.2]) (decode p.1))
  then [timingCodes.headD 0] else []

private theorem check33Five : timingOrigins ≠ [] := by
  decide +kernel

