def slotMatches (o : Option Bool) (b : Bool) : Bool :=
  o.elim true (fun expected => decide (b = expected))

def anySuccessor (m : Nat) (w : List Bool) : Bool :=
  inM m (step2 w false false) || inM m (step2 w false true) ||
    inM m (step2 w true false) || inM m (step2 w true true)

def codeMask (codes : List Nat) : Nat :=
  mask (codes.map decode)

def layerCheck (o : Option Bool) (current next : List Nat) : Bool :=
  let m := codeMask current
  let n := codeMask next
  trap.all (fun w =>
    !slotMatches o (w.headD false) || !anySuccessor n w || inM m w)

